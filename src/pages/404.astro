---
/**
 * Pagina 404 unica para os dois idiomas. A Vercel serve `dist/404.html`
 * para qualquer rota desconhecida, entao nao da para ter uma 404 por
 * idioma; o script abaixo mostra o bloco do idioma da URL (`/pt/...`) e
 * ajusta o `lang` do documento. Sem JS, fica a versao em ingles.
 */
import NotFoundLayout from '../layouts/NotFoundLayout.astro'
import NotFoundContent from '../components/NotFoundContent.astro'
import { ui } from '../i18n/ui'

const consentPt = ui.pt.consent
---

<NotFoundLayout>
  <NotFoundContent locale="en" />
  <NotFoundContent locale="pt" hidden />
</NotFoundLayout>

<script is:inline define:vars={{ consentPt }}>
  ;(function () {
    var isPt = /^\/pt(\/|$)/.test(location.pathname)
    if (!isPt) return
    document.documentElement.lang = 'pt-BR'
    document.title = 'Página não encontrada - Mateus Villain'
    document.querySelectorAll('[data-locale]').forEach(function (block) {
      block.hidden = block.getAttribute('data-locale') !== 'pt'
    })

    // O aviso de cookies e renderizado em ingles no layout; troca as
    // strings junto com o resto da pagina.
    var consent = document.querySelector('.consent')
    if (!consent) return
    consent.setAttribute('aria-label', consentPt.region)
    consent.querySelector('.consent__message').textContent = consentPt.message
    consent.querySelector('[data-consent="grant"]').textContent = consentPt.accept
    consent.querySelector('[data-consent="deny"]').textContent = consentPt.decline
  })()
</script>
