---
import BlogLayout from '../../../layouts/BlogLayout.astro'
import {
  localeStaticPaths,
  localizePath,
  otherLocale,
  type Locale,
} from '../../../i18n/config'
import { ui } from '../../../i18n/ui'
import { blog } from '../../../i18n/blog'
import { formatPostDate, getPosts, postPath, type Post } from '../../../lib/posts'

export function getStaticPaths() {
  return localeStaticPaths()
}

const { locale } = Astro.props as { locale: Locale }
const strings = blog[locale]
const common = ui[locale]

const posts = await getPosts(locale)

const postsByYear: Record<number, Post[]> = {}
for (const post of posts) {
  const year = Number(post.data.date.split('-')[0])
  if (!postsByYear[year]) postsByYear[year] = []
  postsByYear[year].push(post)
}

const years = Object.keys(postsByYear)
  .map(Number)
  .sort((a, b) => b - a)
---

<BlogLayout
  locale={locale}
  switchPath={localizePath('/blog/', otherLocale(locale))}
  title={strings.metaTitle}
  description={strings.metaDescription}
  canonicalPath={localizePath('/blog/', locale)}
>
  <lui-breadcrumb>
    <lui-breadcrumb-item href={localizePath('/', locale)}
      >{common.home}</lui-breadcrumb-item
    >
  </lui-breadcrumb>
  <div class="post-details">
    <h1 class="title m-t-fluid-16">{strings.title}</h1>
  </div>
  <div data-hover-highlight>
    {
      years.map((year) => (
        <section class="posts--group">
          <h2 class="body--lg">{year}</h2>
          {postsByYear[year]!.map((post) => (
            <article class="post interaction-item">
              <a href={postPath(post)}>
                <div class="post-header">
                  <h3 class="body--lg">{post.data.title}</h3>
                  <p class="body--lg">{post.data.description}</p>
                </div>
                <time class="body--lg" datetime={post.data.date}>
                  {formatPostDate(post.data.date, locale, { withYear: false })}
                </time>
              </a>
            </article>
          ))}
        </section>
      ))
    }
  </div>
</BlogLayout>

<script>
  import '@lets-ui/components'
  import { initHoverHighlight } from '../../../lib/hover-highlight'

  const list = document.querySelector<HTMLElement>('[data-hover-highlight]')
  if (list) initHoverHighlight(list, '.interaction-item')
</script>
