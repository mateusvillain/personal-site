---
import { getCollection, render } from 'astro:content'
import BlogLayout from '../../../layouts/BlogLayout.astro'
import IconLinkButton from '../../../components/IconLinkButton.astro'
import LangSwitch from '../../../components/LangSwitch.astro'
import {
  defaultLocale,
  localizePath,
  otherLocale,
  type Locale,
} from '../../../i18n/config'
import { ui } from '../../../i18n/ui'
import { blog } from '../../../i18n/blog'
import {
  formatPostDate,
  postAlternates,
  postLocale,
  postPath,
  postSlug,
  readingTime,
  type Post,
} from '../../../lib/posts'

export async function getStaticPaths() {
  const posts = await getCollection('blog')

  return posts.map((post) => {
    const locale = postLocale(post)
    return {
      params: {
        locale: locale === defaultLocale ? undefined : locale,
        slug: postSlug(post),
      },
      props: { post, locale },
    }
  })
}

const { post, locale } = Astro.props as { post: Post; locale: Locale }
const strings = blog[locale]
const common = ui[locale]

const { Content } = await render(post)

const canonicalPath = postPath(post)
const postUrl = new URL(canonicalPath, Astro.site).href

// Caminhos deste post em cada idioma; se nao houver traducao, o link de
// troca de idioma leva para a listagem do blog no outro idioma.
const alternates = await postAlternates(post)
const switchPath =
  alternates[otherLocale(locale)] ?? localizePath('/blog/', otherLocale(locale))

const formattedDate = formatPostDate(post.data.date, locale)
const minutes = readingTime(post.body)
---

<BlogLayout
  locale={locale}
  title={post.data.title}
  description={post.data.description}
  canonicalPath={canonicalPath}
  alternates={alternates}
  cover={post.data.cover}
  showAuthor
>
  <div class="flex justify-between items-center">
    <lui-breadcrumb>
      <lui-breadcrumb-item href={localizePath('/', locale)}
        >{common.home}</lui-breadcrumb-item
      >
      <lui-breadcrumb-item href={localizePath('/blog/', locale)}
        >{common.blog}</lui-breadcrumb-item
      >
    </lui-breadcrumb>
    <LangSwitch locale={locale} href={switchPath} />
  </div>

  <article class="full-post">
    <section class="post-details">
      <lui-flex direction="column" gap="24" class="m-t-fluid-16">
        <lui-heading variant="title">{post.data.title}</lui-heading>
        <lui-flex direction="row" justify="space-between">
          <lui-flex direction="row">
            <time class="body--md" datetime={post.data.date}
              >{formattedDate}</time
            >
            <p class="read-time body--md">{strings.readTime(minutes)}</p>
          </lui-flex>

          <lui-flex direction="row" gap="8">
            <!-- Copy link -->
            <lui-icon-button
              aria-label={strings.copyLink}
              size="md"
              id="copy-link"
              data-copied-text={strings.linkCopied}
              data-failed-text={strings.copyFailed}
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                fill="none"
                viewBox="0 0 24 24"
              >
                <path
                  fill="#000"
                  d="M22.5 8.271a5.102 5.102 0 0 1-1.5 3.47L17.742 15a5.086 5.086 0 0 1-3.621 1.5h-.005A5.12 5.12 0 0 1 9 11.235a.75.75 0 1 1 1.5.042 3.621 3.621 0 0 0 6.177 2.663l3.258-3.258a3.622 3.622 0 0 0-5.121-5.122l-1.032 1.031a.75.75 0 0 1-1.06-1.06L13.753 4.5a5.122 5.122 0 0 1 8.385 1.731 5.16 5.16 0 0 1 .362 2.04Zm-12.281 9.134-1.031 1.032a3.602 3.602 0 0 1-2.57 1.063 3.622 3.622 0 0 1-2.558-6.182l3.253-3.258a3.621 3.621 0 0 1 6.187 2.663.75.75 0 0 0 1.5.042A5.14 5.14 0 0 0 13.5 9a5.123 5.123 0 0 0-7.244 0L3 12.258a5.12 5.12 0 0 0 7.238 7.242l1.03-1.032a.75.75 0 0 0-1.05-1.063Z"
                ></path>
              </svg>
            </lui-icon-button>
            <span
              id="copy-link-status"
              class="sr-only"
              role="status"
              aria-live="polite"></span>

            <!-- LinkedIn -->
            <IconLinkButton
              href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(postUrl)}`}
              target="_blank"
              ariaLabel={strings.shareLinkedin}
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="16"
                height="16"
                fill="none"
                viewBox="0 0 32 32"
              >
                <g clip-path="url(#a)">
                  <path
                    fill="#000"
                    d="M5.25 9.625a1 1 0 0 1 1 1v17.5a1 1 0 1 1-2 0v-17.5a1 1 0 0 1 1-1Zm13.75 0c2.317 0 4.541.91 6.183 2.531a8.61 8.61 0 0 1 2.567 6.125v9.844a1 1 0 1 1-2 0v-9.844a6.61 6.61 0 0 0-1.973-4.702A6.798 6.798 0 0 0 19 11.625a6.798 6.798 0 0 0-4.777 1.954 6.61 6.61 0 0 0-1.973 4.702v9.844a1 1 0 1 1-2 0v-17.5a1 1 0 1 1 2 0v2.148A8.799 8.799 0 0 1 19 9.625ZM5.312 4.5a1.563 1.563 0 1 1 0 3.125 1.563 1.563 0 0 1 0-3.125Z"
                  ></path>
                </g>
                <defs>
                  <clipPath id="a">
                    <path fill="#fff" d="M0 0h32v32H0z"></path>
                  </clipPath>
                </defs>
              </svg>
            </IconLinkButton>

            <!-- X -->
            <IconLinkButton
              href={`https://x.com/intent/tweet?text=${encodeURIComponent(post.data.title)}&url=${encodeURIComponent(postUrl)}`}
              target="_blank"
              ariaLabel={strings.shareX}
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="16"
                height="16"
                fill="none"
                viewBox="0 0 32 32"
              >
                <path
                  fill="#000"
                  d="m26.844 26.464-7.825-12.298 7.721-8.494a1 1 0 0 0-1.48-1.345l-7.355 8.09-5.061-7.953A1 1 0 0 0 12 4H6a1 1 0 0 0-.844 1.537l7.825 12.297-7.721 8.5a1 1 0 1 0 1.48 1.345l7.355-8.09 5.061 7.954A1 1 0 0 0 20 28h6a1 1 0 0 0 .844-1.536ZM20.549 26 7.82 6h3.625L24.18 26h-3.63Z"
                ></path>
              </svg>
            </IconLinkButton>
          </lui-flex>
        </lui-flex>
      </lui-flex>
    </section>

    <Content />
  </article>
</BlogLayout>

<script>
  const copy = document.getElementById('copy-link')
  const copyStatus = document.getElementById('copy-link-status')

  copy?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(window.location.href)
      if (copyStatus) copyStatus.textContent = copy.dataset.copiedText ?? ''
    } catch (err) {
      console.error('Erro ao copiar', err)
      if (copyStatus) copyStatus.textContent = copy.dataset.failedText ?? ''
    }
  })
</script>

<script>
  import '@lets-ui/components'
</script>
