---
/** Bloco do autor no rodape dos posts do blog. */
import IconLinkButton from './IconLinkButton.astro'
import type { Locale } from '../i18n/config'
import { ui } from '../i18n/ui'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const strings = ui[locale].author
---

<section class="flex gap-fixed-16">
  <lui-image
    src="/img/mtsvlln.jpg"
    alt="Mateus Villain"
    radius="circle"
    aspect-ratio="1/1"
    width="64px"
    height="64px"
  >
  </lui-image>
  <lui-flex direction="column" gap="4">
    <lui-heading variant="headline">Mateus Villain</lui-heading>
    <lui-body variant="lg">{strings.bio}</lui-body>

    <div class="social-media-icons flex gap-fixed-8 m-t-fixed-8">
      <!-- LinkedIn -->
      <IconLinkButton
        size="lg"
        href="https://www.linkedin.com/in/mateusvillain"
        ariaLabel={strings.linkedin}
        target="_blank"
        rel="noopener noreferrer"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 256 256"
          style="color: var(--lui-color-neutral-icon-default)"
          ><rect width="256" height="256" fill="none"></rect><rect
            x="32"
            y="32"
            width="192"
            height="192"
            rx="8"
            fill="none"
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="16"></rect><line
            x1="120"
            y1="112"
            x2="120"
            y2="176"
            fill="none"
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="16"></line><line
            x1="88"
            y1="112"
            x2="88"
            y2="176"
            fill="none"
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="16"></line><path
            d="M120,140a28,28,0,0,1,56,0v36"
            fill="none"
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="16"></path><circle cx="88" cy="84" r="12"
          ></circle></svg
        >
      </IconLinkButton>

      <!-- GitHub -->
      <IconLinkButton
        size="lg"
        href="https://github.com/mateusvillain"
        ariaLabel={strings.github}
        target="_blank"
        rel="noopener noreferrer"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 256 256"
          style="color: var(--lui-color-neutral-icon-default)"
          ><rect width="256" height="256" fill="none"></rect><path
            d="M119.83,56A52,52,0,0,0,76,32a51.92,51.92,0,0,0-3.49,44.7A49.28,49.28,0,0,0,64,104v8a48,48,0,0,0,48,48h48a48,48,0,0,0,48-48v-8a49.28,49.28,0,0,0-8.51-27.3A51.92,51.92,0,0,0,196,32a52,52,0,0,0-43.83,24Z"
            fill="none"
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="16"></path><path
            d="M104,232V192a32,32,0,0,1,32-32h0a32,32,0,0,1,32,32v40"
            fill="none"
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="16"></path><path
            d="M104,208H72a32,32,0,0,1-32-32A32,32,0,0,0,8,144"
            fill="none"
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="16"></path></svg
        >
      </IconLinkButton>

      <!-- X -->
      <IconLinkButton
        size="lg"
        href="https://www.x.com/mateusvillain"
        ariaLabel={strings.x}
        target="_blank"
        rel="noopener noreferrer"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          fill="none"
          viewBox="0 0 32 32"
        >
          <path
            fill="#000"
            d="m26.843 26.464-7.825-12.298 7.722-8.494a1 1 0 0 0-1.48-1.345l-7.355 8.09-5.062-7.953A1 1 0 0 0 12 4H6a1 1 0 0 0-.844 1.537l7.825 12.297-7.721 8.5a1 1 0 1 0 1.48 1.345l7.355-8.09 5.061 7.954A1 1 0 0 0 20 28h6a1 1 0 0 0 .843-1.536ZM20.55 26 7.82 6h3.625l12.732 20h-3.63Z"
          ></path>
        </svg>
      </IconLinkButton>
    </div>
  </lui-flex>
</section>
