---
/**
 * Simulador do escritorio (/office/): canvas isometrico em pixel art
 * desenhado por `public/js/office.js`. As descricoes aparecem em um tooltip ao
 * passar o mouse sobre os objetos.
 */
import SiteHeader from './SiteHeader.astro'
import { localizePath, type Locale } from '../i18n/config'
import { ui } from '../i18n/ui'
import { office } from '../i18n/office'

interface Props {
  locale: Locale
  switchPath: string
}

const { locale, switchPath } = Astro.props
const strings = office[locale]
const common = ui[locale]
---

<a href="#main" class="skip-link">{common.skipLink}</a>
<SiteHeader locale={locale} switchPath={switchPath} />
<div class="body-container gap-fluid-80">
  <main id="main" class="hero flex flex-col gap-fluid-40">

    <section class="office" data-office>
      <div class="office__stage">
        <canvas
          class="office__canvas"
          width="472"
          height="456"
          role="img"
          aria-label={strings.canvasLabel}
          data-office-canvas></canvas>
        <div class="office__tip" data-office-tip hidden aria-hidden="true"></div>
      </div>
      <noscript><p class="body--lg">{strings.noScript}</p></noscript>
    </section>
  </main>
</div>

<script
  type="application/json"
  id="office-data"
  set:html={JSON.stringify({
    objects: strings.objects,
  })}
/>
<script is:inline src="/js/office.js"></script>
