---
/**
 * Capa do card do Let's UI.
 *
 * Uma miniatura navegavel do site de documentacao, montada em HTML: as
 * secoes trocam o conteudo, as abas trocam o conjunto de secoes e a
 * busca filtra a navegacao.
 *
 * A miniatura e desenhada na escala do Figma (580x310 num quadro de
 * 724px) e reescalada pelo CSS: o container define 1em = 1px do
 * desenho, entao todas as medidas aqui sao proporcionais.
 */
const { id = 'lui' } = Astro.props
const uid = (name) => `${id}-${name}`

const sections = {
  documentation: [
    {
      group: 'Get started',
      pages: [
        {
          title: 'Introduction',
          lede: 'Understand the principles behind the system and how to adopt it.',
          body: "Let's UI is built around fluid tokens: every size, space and type step is a clamp() that adapts to the viewport instead of jumping between breakpoints. Start here to understand the vocabulary, the brand layers and how a product plugs into the system without forking it.",
        },
        {
          title: 'Design',
          lede: 'Explore design guidelines, and access Figma libraries and plugins.',
          body: "Immerse yourself in our extensive design system documentation, where you can uncover invaluable best practices, leverage our meticulously curated Figma libraries, and supercharge your workflow with a selection of essential plugins tailored for efficiency and creativity. Whether you're a novice or a seasoned designer, our resources are designed to elevate your design experience and streamline your projects.",
        },
        {
          title: 'Develop',
          lede: 'Install the packages and ship the components in any stack.',
          body: 'The components are web components: they run the same in React, Vue, Astro or plain HTML. Install @lets-ui/components, import the styles, and the tokens arrive as CSS custom properties you can read from your own code.',
        },
        {
          title: 'Changelog',
          lede: 'Every release, with the reasoning behind each change.',
          body: 'Releases follow semantic versioning. Breaking changes always come with a migration note and, whenever possible, a codemod. Deprecated tokens keep working for one major version before being removed.',
        },
      ],
    },
    {
      group: 'Foundation',
      pages: [
        {
          title: 'Accessibility',
          lede: 'Contrast, focus and motion as part of the token layer.',
          body: 'Accessibility is not a checklist at the end: contrast pairs are baked into the color tokens, focus rings are a token of their own, and every animation respects prefers-reduced-motion by default.',
        },
        {
          title: 'Color',
          lede: 'A multi-brand palette built from a single scale.',
          body: 'Each brand declares its own primitives; the semantic layer stays the same. That is what lets the same component render in a different brand by switching a single data-brand attribute on the root element.',
        },
        {
          title: 'Icons',
          lede: 'A consistent set, sized by the type scale.',
          body: 'Icons inherit currentColor and align to the text they sit next to. Sizes come from the same fluid scale as typography, so an icon never drifts away from its label.',
        },
        {
          title: 'Spacing',
          lede: 'Fixed and fluid spacing, side by side.',
          body: 'Fixed spacing keeps component internals stable; fluid spacing lets layouts breathe as the viewport grows. Both live in the same scale, so mixing them stays predictable.',
        },
        {
          title: 'Typography',
          lede: 'Type that scales with the viewport, not with breakpoints.',
          body: 'Every step of the type scale is a clamp() between a minimum and a maximum, interpolated by viewport width. The result is text that never jumps and never needs a media query.',
        },
      ],
    },
  ],
  patterns: [
    {
      group: 'Forms',
      pages: [
        {
          title: 'Sign in',
          lede: 'The shortest path between a user and their account.',
          body: 'One column, labels above the fields, errors attached to the input they belong to. The submit button stays enabled so the form can explain what is missing instead of hiding the way forward.',
        },
        {
          title: 'Validation',
          lede: 'Tell people what happened, where, and what to do next.',
          body: 'Validate on blur, never on every keystroke. Messages are specific and actionable, and the first invalid field takes focus when the form is submitted.',
        },
        {
          title: 'Filters',
          lede: 'Narrowing a list without losing the list.',
          body: 'Filters are additive and always reversible. The current selection is visible as chips, and clearing everything is a single action.',
        },
      ],
    },
    {
      group: 'Feedback',
      pages: [
        {
          title: 'Empty state',
          lede: 'An empty screen is still a screen with a job to do.',
          body: 'Say what would normally be here, why it is not, and offer the one action that fills it. Illustration is optional; the sentence is not.',
        },
        {
          title: 'Loading',
          lede: 'Skeletons for layout, spinners for actions.',
          body: 'If the shape of the result is known, show the shape. If it is a single action, show progress on the control that started it.',
        },
        {
          title: 'Errors',
          lede: 'Blame the system, never the person.',
          body: 'Plain language, no error codes in the headline, and always a way out: retry, go back, or contact support with the details already filled in.',
        },
      ],
    },
  ],
}

const tabs = [
  { key: 'documentation', label: 'Documentation' },
  { key: 'patterns', label: 'Patterns' },
]

const initial = sections.documentation[0].pages[1] // "Design", como no Figma
---

<div class="luicover">
  <div class="luisite" data-lui-site={id}>
    <div class="luisite__bar">
      <span class="luisite__logo" aria-hidden="true">
        <svg width="16" height="16" viewBox="0 0 16.0838 16" fill="none">
