            fill="currentColor"></path>
          <path d="M18.6125 3.17333L18.4382 0H19.6043L19.43 3.17333H18.6125Z" fill="currentColor"
          ></path>
          <path
            d="M16.2526 9.46667C15.6092 9.46667 15.1312 9.29333 14.8184 8.94667C14.5057 8.6 14.3493 8.07111 14.3493 7.36V3.45333H13.3039L13.3173 2.44H13.974C14.1974 2.44 14.3583 2.4 14.4565 2.32C14.5638 2.24 14.6263 2.10667 14.6442 1.92L14.7782 0.880001H15.5288V2.44H17.5259V3.46667H15.5288V7.33333C15.5288 7.68889 15.6092 7.94667 15.77 8.10667C15.9398 8.25778 16.1811 8.33333 16.4938 8.33333C16.6636 8.33333 16.8378 8.31111 17.0165 8.26667C17.2042 8.22222 17.3874 8.13333 17.5661 8V9.21333C17.3069 9.31111 17.0657 9.37778 16.8423 9.41333C16.6278 9.44889 16.4313 9.46667 16.2526 9.46667Z"
            fill="currentColor"></path>
          <path
            d="M9.50471 9.50667C8.95965 9.50667 8.47714 9.42667 8.05717 9.26667C7.64614 9.09778 7.29766 8.85778 7.01173 8.54667C6.7258 8.23556 6.51135 7.86667 6.36838 7.44C6.22541 7.01333 6.15393 6.53333 6.15393 6C6.15393 5.45778 6.22541 4.96 6.36838 4.50667C6.51135 4.05333 6.72133 3.65778 6.99833 3.32C7.27532 2.98222 7.61487 2.72445 8.01696 2.54667C8.41906 2.36 8.87923 2.26667 9.39749 2.26667C9.85319 2.26667 10.2687 2.34222 10.644 2.49333C11.0193 2.64445 11.3365 2.88 11.5956 3.2C11.8637 3.51111 12.0647 3.90667 12.1987 4.38667C12.3328 4.85778 12.3864 5.41333 12.3596 6.05333L6.91791 6.09333V5.26667L11.6224 5.22667L11.2069 5.78667C11.2516 5.22667 11.198 4.76445 11.0461 4.4C10.8942 4.03556 10.6753 3.76 10.3893 3.57333C10.1123 3.38667 9.78171 3.29333 9.39749 3.29333C8.98646 3.29333 8.62457 3.4 8.31183 3.61333C7.99909 3.82667 7.75784 4.13333 7.58806 4.53333C7.42723 4.93333 7.34681 5.41778 7.34681 5.98667C7.34681 6.80445 7.52998 7.43111 7.89634 7.86667C8.26269 8.29333 8.80775 8.50667 9.53152 8.50667C9.80852 8.50667 10.0498 8.47556 10.2553 8.41333C10.4697 8.34222 10.6484 8.24889 10.7914 8.13333C10.9433 8.00889 11.0639 7.86667 11.1533 7.70667C11.2516 7.54667 11.3275 7.37333 11.3812 7.18667L12.4534 7.44C12.373 7.76 12.2479 8.04889 12.0781 8.30667C11.9173 8.55556 11.7118 8.76889 11.4616 8.94667C11.2203 9.12445 10.9388 9.26222 10.6172 9.36C10.2955 9.45778 9.92468 9.50667 9.50471 9.50667Z"
            fill="currentColor"></path>
          <path
            d="M0 9.33333V0.533334H1.23309V9.33333H0ZM0.402094 9.33333V8.26667H5.36126V9.33333H0.402094Z"
            fill="currentColor"></path>
        </svg>
      </span>

      <div class="luisite__tabs" role="group" aria-label="Let's UI docs">
        {
          tabs.map((tab, index) => (
            <button
              type="button"
              class="luisite__tab"
              data-lui-tab={tab.key}
              tabindex="-1"
              aria-pressed={index === 0 ? 'true' : 'false'}
            >
              {tab.label}
            </button>
          ))
        }
      </div>

      <input
        type="search"
        class="luisite__search"
        data-lui-search
        tabindex="-1"
        placeholder="Search"
        aria-label="Search the documentation"
      />
    </div>

    <nav class="luisite__nav" data-lui-nav aria-label="Documentation sections">
      <!-- preenchida pelo script a partir do JSON abaixo -->
    </nav>

    <article class="luisite__panel" data-lui-panel aria-live="polite">
      <h4 class="luisite__title" data-lui-page-title>{initial.title}</h4>
      <p class="luisite__lede" data-lui-page-lede>{initial.lede}</p>
      <p class="luisite__body" data-lui-page-body>{initial.body}</p>
    </article>

    <p class="luisite__empty" data-lui-empty hidden>No results.</p>
  </div>

  <script
    type="application/json"
    data-lui-data={id}
    set:html={JSON.stringify(sections)}
  />
</div>

<script>
  /* ---------------------------------------------------------------------
     Miniatura do site de documentacao do Let's UI.
     - a aba troca o conjunto de secoes
     - a secao troca o conteudo do painel
     - a busca filtra a navegacao (e o painel some quando nada casa)
  --------------------------------------------------------------------- */
  document.querySelectorAll('[data-lui-site]').forEach((site) => {
    const id = site.dataset.luiSite
    const source = document.querySelector(`[data-lui-data="${id}"]`)
    if (!source) return

    let data
    try {
      data = JSON.parse(source.textContent || '{}')
    } catch {
      return
    }

    const nav = site.querySelector('[data-lui-nav]')
    const panel = site.querySelector('[data-lui-panel]')
    const empty = site.querySelector('[data-lui-empty]')
    const search = site.querySelector('[data-lui-search]')
    const fields = {
      title: site.querySelector('[data-lui-page-title]'),
      lede: site.querySelector('[data-lui-page-lede]'),
      body: site.querySelector('[data-lui-page-body]'),
    }

    let tab = 'documentation'
    let current = data.documentation[0].pages[1].title

    const show = (page) => {
      current = page.title
      fields.title.textContent = page.title
      fields.lede.textContent = page.lede
      fields.body.textContent = page.body
      nav.querySelectorAll('[data-lui-page]').forEach((item) => {
        item.setAttribute(
          'aria-current',
          item.dataset.luiPage === page.title ? 'page' : 'false'
        )
      })
    }

    const findPage = (title) =>
      data[tab]
        .flatMap((group) => group.pages)
        .find((page) => page.title === title)

    const renderNav = (query = '') => {
      const term = query.trim().toLowerCase()
      nav.textContent = ''
      let visible = 0

      data[tab].forEach((group) => {
        const pages = term
          ? group.pages.filter((page) =>
              `${page.title} ${page.lede}`.toLowerCase().includes(term)
            )
          : group.pages
        if (!pages.length) return

        const heading = document.createElement('p')
        heading.className = 'luisite__group'
        heading.textContent = group.group
        nav.append(heading)

        const list = document.createElement('ul')
        list.className = 'luisite__list'

        pages.forEach((page) => {
          const item = document.createElement('li')
          const button = document.createElement('button')
          button.type = 'button'
          button.className = 'luisite__link'
          button.tabIndex = -1
          button.dataset.luiPage = page.title
          button.textContent = page.title
          button.setAttribute(
            'aria-current',
            page.title === current ? 'page' : 'false'
          )
          button.addEventListener('click', () => show(page))
          item.append(button)
          list.append(item)
          visible += 1
        })

        nav.append(list)
      })

      const nothing = visible === 0
      empty.hidden = !nothing
      panel.hidden = nothing
    }

    site.querySelectorAll('[data-lui-tab]').forEach((button) => {
      button.addEventListener('click', () => {
        tab = button.dataset.luiTab
        site.querySelectorAll('[data-lui-tab]').forEach((other) => {
          other.setAttribute('aria-pressed', String(other === button))
        })
        const first = data[tab][0].pages[0]
        show(first)
        if (search) search.value = ''
        renderNav()
      })
    })

    search?.addEventListener('input', () => renderNav(search.value))

    // o campo de busca nao deve arrastar o card junto
    search?.addEventListener('pointerdown', (event) => event.stopPropagation())

    renderNav()
    show(findPage(current))
  })
</script>
