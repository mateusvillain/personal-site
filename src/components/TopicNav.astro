---
/**
 * Links para as paginas de tema do idioma (ver src/lib/topics.ts). Na
 * listagem do blog e nas paginas de tema; `current` marca o tema aberto.
 */
import type { Locale } from '../i18n/config'
import { blog } from '../i18n/blog'
import { getTopics, type TopicId } from '../lib/topics'

interface Props {
  locale: Locale
  current?: TopicId
}

const { locale, current } = Astro.props
const strings = blog[locale]
const topics = await getTopics(locale)
---

{
  topics.length > 0 && (
    <nav class="post-topics" aria-label={strings.topicsLabel}>
      <span class="body--md">{strings.topicsLabel}:</span>
      <ul>
        {topics.map((topic) => (
          <li>
            <a
              class="topic-link"
              href={topic.path}
              aria-current={topic.id === current ? 'page' : undefined}
            >
              {topic.name}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )
}
