---
import SiteHeader from './SiteHeader.astro'
import { localizePath, type Locale } from '../i18n/config'
import { ui } from '../i18n/ui'
import { mentorship } from '../i18n/mentorship'

interface Props {
  locale: Locale
  switchPath: string
}

const { locale, switchPath } = Astro.props
const strings = mentorship[locale]
const common = ui[locale]
const { pricing, faq } = strings
---

<a href="#main" class="skip-link">{common.skipLink}</a>
<SiteHeader locale={locale} switchPath={switchPath} />
<div class="body-container gap-fluid-80">
  <main id="main" class="hero flex flex-col gap-fluid-80">
    <div>
      <lui-breadcrumb>
        <lui-breadcrumb-item href={localizePath('/', locale)}
          >{common.home}</lui-breadcrumb-item
        >
      </lui-breadcrumb>
      <div class="m-t-fluid-16 m-b-fluid-8">
        <lui-heading variant="title">{strings.title}</lui-heading>
      </div>
      <lui-body variant="lg">{strings.intro}</lui-body>

      <div class="alert alert--success m-t-fluid-24">
        <div class="alert__content">
          <ph-check-circle size="24" color="#23963B" weight="fill">
          </ph-check-circle>
          <div class="alert__text">
            <p class="body--lg">{strings.openAgenda}</p>
            <p class="body--lg" set:html={strings.contactHtml}></p>
          </div>
        </div>
      </div>
    </div>

    <section class="flex flex-col">
      <ul class="no-list flex flex-col gap-fluid-40">
        <li>
          <ph-chalkboard-simple size="32"></ph-chalkboard-simple>
          <div class="flex flex-col gap-fluid-4">
            <lui-body variant="lg" bold>{strings.topics.title}</lui-body>
            <lui-body variant="lg">{strings.topics.description}</lui-body>
            <div class="flex flex-wrap gap-fluid-8 m-t-fluid-16">
              {
                strings.topics.tags.map((tag) => (
                  <lui-tag label={tag} style="surface" variant="primary" />
                ))
              }
            </div>
          </div>
        </li>
        <li>
          <ph-hourglass-medium size="32"></ph-hourglass-medium>
          <lui-body variant="lg" bold>{strings.duration.title}</lui-body>
          <lui-body variant="lg">{strings.duration.description}</lui-body>
        </li>
        <li>
          <ph-video-conference size="32"></ph-video-conference>
          <lui-body variant="lg" bold>{strings.where.title}</lui-body>
          <lui-body variant="lg">{strings.where.description}</lui-body>
        </li>
      </ul>
    </section>

    <!-- Categorias e valores -->
    <section class="flex flex-col gap-fluid-24">
      <h2 class="headline">{pricing.title}</h2>

      <!-- Mentoria -->
      <lui-card>
        <div class="card__body">
          <div class="flex flex-col gap-fluid-4">
            <h3 class="block-title">{pricing.mentoring.title}</h3>
            <p class="body--lg">{pricing.mentoring.description}</p>
          </div>
          <ul class="no-list flex flex-col gap-fluid-8 m-y-fluid-24">
            {
              pricing.mentoring.items.map((item) => (
                <li class="flex gap-fluid-8">
                  <ph-check size="24" color="#23963B" />
                  <p class="body--lg">{item}</p>
                </li>
              ))
            }
          </ul>
          <p class="flex content-center gap-fluid-2">
            <lui-heading variant="subheadline" as="span"
              >{pricing.mentoring.price}</lui-heading
            >
            <span class="body--md m-t-fluid-2">{pricing.perSession}</span>
          </p>
        </div>
      </lui-card>

      <!-- Acompanhamento -->
      <lui-card>
        <div class="card__body">
          <div class="flex flex-col gap-fluid-4">
            <h3 class="block-title">{pricing.coaching.title}</h3>
            <p class="body--lg">{pricing.coaching.description}</p>
          </div>
          <ul class="no-list flex flex-col gap-fluid-8 m-y-fluid-24">
            {
              pricing.coaching.items.map((item) => (
                <li class="flex gap-fluid-8">
                  <ph-check size="24" color="#23963B" />
                  <p class="body--lg">{item}</p>
                </li>
              ))
            }
          </ul>
          <p class="flex content-center gap-fluid-2">
            <span class="subheadline text-bold">{pricing.coaching.price}</span>
            <span class="body--md m-t-fluid-2">{pricing.perSession}</span>
          </p>
        </div>
      </lui-card>

      <!-- Consultoria -->
      <lui-card>
        <div class="card__body">
          <div class="flex flex-col gap-fluid-4">
            <h3 class="block-title">{pricing.consulting.title}</h3>
            <p class="body--lg">{pricing.consulting.description}</p>
          </div>
          <ul class="no-list flex flex-col gap-fluid-8 m-y-fluid-24">
            {
              pricing.consulting.items.map((item) => (
                <li class="flex gap-fluid-8">
                  <ph-check size="24" color="#23963B" />
                  <p class="body--lg">{item}</p>
                </li>
              ))
            }
          </ul>
          <p class="body--lg" set:html={pricing.consulting.contactHtml}></p>
        </div>
      </lui-card>
    </section>

    <!-- FAQ -->
    <section class="flex flex-col gap-fluid-24">
      <lui-heading variant="headline">{faq.title}</lui-heading>
      <div class="flex flex-col gap-fluid-16">
        {
          faq.items.map((item) => (
            <div class="faq-item flex flex-col gap-fluid-4">
              <lui-heading variant="block-title" as="h4">
                {item.question}
              </lui-heading>
              <lui-body variant="lg">{item.answer}</lui-body>
            </div>
          ))
        }
      </div>
    </section>
  </main>
</div>

<script>
  import '@lets-ui/components'
</script>
