---
/**
 * Cabecalho do site: barra de hora/clima e idioma/tema (`.site-topbar`) e o
 * header fixo com marca, navegacao e redes (`.site-header`).
 *
 * Desktop: a barra fica fixa nas laterais, alinhada ao header. Mobile: a barra
 * fica no fluxo, acima do header, e o header (sticky) a cobre no scroll. O
 * menu mobile repete idioma e tema no rodape, por isso o seletor de tema de
 * la usa outro `name`.
 *
 * Hora e clima sao preenchidos por `public/js/time.js` e `weather.js`.
 */
import LangToggle from './LangToggle.astro'
import ThemeToggle from './ThemeToggle.astro'
import { localizePath, type Locale } from '../i18n/config'
import { ui } from '../i18n/ui'

interface Props {
  locale: Locale
  /** Caminho desta pagina no outro idioma. */
  switchPath: string
}

const { locale, switchPath } = Astro.props
const strings = ui[locale]
const homePath = localizePath('/', locale)
// Compara sem a barra final: '/pt' e '/pt/' sao a mesma pagina.
const trimSlash = (path: string) => path.replace(/\/+$/, '')
const pathname = trimSlash(Astro.url.pathname)
const isHome = pathname === trimSlash(homePath)

const links = [
  { href: localizePath('/blog/', locale), label: strings.nav.blog, id: 'blog' },
  {
    href: localizePath('/mentorship/', locale),
    label: strings.nav.mentorship,
    id: 'mentorship',
  },
  {
    href: localizePath('/resources/', locale),
    label: strings.nav.resources,
    id: 'resources',
  },
]

const isCurrent = (href: string) => pathname.startsWith(trimSlash(href))

const socials = [
  {
    id: 'linkedin',
    name: 'LinkedIn',
    href: 'https://www.linkedin.com/in/mateusvillain',
    ariaLabel: strings.author.linkedin,
    path: 'M19.041,19.041L16.078,19.041L16.078,14.4C16.078,13.294,16.058,11.869,14.536,11.869C12.993,11.869,12.757,13.075,12.757,14.32L12.757,19.041L9.793,19.041L9.793,9.497L12.638,9.497L12.638,10.802L12.678,10.802C12.963,10.315,13.374,9.914,13.868,9.643C14.363,9.371,14.921,9.239,15.485,9.26C18.488,9.26,19.042,11.236,19.042,13.806L19.041,19.041ZM6.45,8.193C6.11,8.193,5.777,8.092,5.494,7.903C5.211,7.714,4.991,7.446,4.861,7.132C4.73,6.817,4.696,6.472,4.763,6.138C4.829,5.804,4.993,5.498,5.233,5.257C5.474,5.017,5.78,4.853,6.114,4.786C6.447,4.72,6.793,4.754,7.107,4.884C7.421,5.014,7.69,5.235,7.879,5.517C8.068,5.8,8.169,6.133,8.169,6.473C8.169,6.699,8.125,6.922,8.038,7.131C7.952,7.34,7.825,7.529,7.666,7.689C7.506,7.849,7.316,7.975,7.108,8.062C6.899,8.148,6.676,8.193,6.45,8.193ZM7.931,19.041L4.965,19.041L4.965,9.497L7.931,9.497L7.931,19.041ZM20.518,2.001L3.476,2.001C3.089,1.997,2.716,2.146,2.44,2.417C2.163,2.687,2.005,3.056,2,3.443L2,20.557C2.005,20.944,2.163,21.313,2.439,21.584C2.716,21.854,3.089,22.004,3.476,22L20.518,22C20.906,22.005,21.28,21.855,21.558,21.585C21.836,21.314,21.995,20.945,22,20.557L22,3.442C21.995,3.054,21.835,2.685,21.557,2.414C21.28,2.144,20.906,1.995,20.518,2',
  },
  {
    id: 'x',
    name: 'X',
    href: 'https://www.x.com/mateusvillain',
    ariaLabel: strings.author.x,
    path: 'M13.903,10.468L21.349,2L19.584,2L13.119,9.353L7.956,2L2,2L9.808,13.119L2,22L3.765,22L10.591,14.235L16.044,22L22,22L13.903,10.468ZM11.486,13.218L10.695,12.11L4.4,3.3L7.11,3.3L12.19,10.41L12.981,11.518L19.585,20.759L16.875,20.759L11.486,13.218Z',
  },
  {
    id: 'github',
    name: 'GitHub',
    href: 'https://github.com/mateusvillain',
    ariaLabel: strings.author.github,
    fillRule: 'evenodd',
    path: 'M11.902,1.551C6.021,1.551,1.267,6.34,1.267,12.265C1.267,17.001,4.313,21.01,8.539,22.429C9.067,22.535,9.26,22.198,9.26,21.915C9.26,21.666,9.243,20.815,9.243,19.928C6.285,20.566,5.669,18.651,5.669,18.651C5.193,17.409,4.489,17.09,4.489,17.09C3.52,16.434,4.559,16.434,4.559,16.434C5.633,16.504,6.197,17.533,6.197,17.533C7.147,19.165,8.679,18.704,9.296,18.42C9.384,17.728,9.665,17.249,9.965,16.983C7.605,16.735,5.123,15.813,5.123,11.697C5.123,10.527,5.545,9.569,6.214,8.824C6.109,8.558,5.739,7.458,6.32,5.986C6.32,5.986,7.218,5.702,9.243,7.086C10.11,6.851,11.004,6.732,11.902,6.731C12.799,6.731,13.715,6.855,14.56,7.086C16.585,5.702,17.483,5.986,17.483,5.986C18.064,7.458,17.694,8.558,17.589,8.824C18.275,9.569,18.68,10.527,18.68,11.697C18.68,15.813,16.198,16.717,13.821,16.983C14.208,17.32,14.543,17.959,14.543,18.97C14.543,20.407,14.525,21.56,14.525,21.914C14.525,22.198,14.719,22.535,15.247,22.429C19.473,21.01,22.519,17.001,22.519,12.265C22.536,6.34,17.765,1.551,11.902,1.551Z',
  },
]
---

<section class="site-topbar" aria-label={strings.topbar.label}>
  <div class="site-topbar__info">
    <p class="body--sm">
      <span class="sr-only">{strings.topbar.time}</span>
      <span id="hora"></span>
    </p>
    <p class="body--sm">
      <span class="sr-only">{strings.topbar.weather}</span>
      <span id="clima"></span>
    </p>
  </div>
  <div class="site-topbar__controls">
    <LangToggle locale={locale} href={switchPath} />
    <ThemeToggle locale={locale} />
  </div>
</section>

<header class="site-header" data-site-header>
  <div class="site-header__panel">
    <div class="site-header__bar">
      <div class="site-header__brand">
        {
          /* Na inicial a foto e so decorativa: o link levaria a propria pagina. */
          isHome ? (
            <span class="site-header__logo">
              <img src="/img/mtsvlln.jpg" width="32" height="32" alt="" />
            </span>
          ) : (
            <a
              class="site-header__logo"
              href={homePath}
              aria-label={`${strings.siteName} – ${strings.nav.home}`}
              data-link="home"
            >
              <img src="/img/mtsvlln.jpg" width="32" height="32" alt="" />
            </a>
          )
        }

        <nav class="site-header__nav" aria-label={strings.nav.label}>
          <ul data-header-nav>
            {
              links.map((link) => (
                <li>
                  <a
                    class="site-header__link"
                    href={link.href}
                    aria-current={isCurrent(link.href) ? 'page' : undefined}
                    data-link={link.id}
                  >
                    {link.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>

      <ul class="site-header__social" aria-label={strings.nav.social}>
        {
          socials.map((social) => (
            <li class="tooltip tooltip--bottom">
              <a
                class="icon-button icon-button--lg"
                href={social.href}
                aria-label={social.ariaLabel}
                target="_blank"
                rel="noopener noreferrer"
                data-social={social.id}
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="24"
                  height="24"
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                >
                  <path
                    fill="currentColor"
                    fill-rule={social.fillRule}
                    d={social.path}
                  />
                </svg>
              </a>
              <span class="tooltip__content" aria-hidden="true">
                {social.name}
              </span>
            </li>
          ))
        }
      </ul>

      <button
        type="button"
        class="site-header__menu-button"
        aria-expanded="false"
        aria-controls="site-menu"
        aria-label={strings.nav.menu}
        data-menu-button
      >
        <svg
          class="site-header__menu-icon"
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
      </button>
    </div>

    <div class="site-header__menu" id="site-menu">
      <nav aria-label={strings.nav.label}>
        <ul>
          <li>
            <a
              class="site-header__menu-link"
              href={homePath}
              aria-current={isHome ? 'page' : undefined}
              data-link="home">{strings.nav.home}</a
            >
          </li>
          {
            links.map((link) => (
              <li>
                <a
                  class="site-header__menu-link"
                  href={link.href}
                  aria-current={isCurrent(link.href) ? 'page' : undefined}
                  data-link={link.id}
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="site-header__menu-controls">
        <LangToggle locale={locale} href={switchPath} />
        <ThemeToggle locale={locale} name="theme-menu" />
      </div>
    </div>
  </div>
</header>

<script>
  import { initHoverHighlight } from '../lib/hover-highlight'

  const header = document.querySelector<HTMLElement>('[data-site-header]')
  const button = header?.querySelector<HTMLButtonElement>('[data-menu-button]')
  const nav = header?.querySelector<HTMLElement>('[data-header-nav]')
  const desktop = window.matchMedia('(min-width: 768px)')

  if (nav) initHoverHighlight(nav, '.site-header__link')

  const panel = header?.querySelector<HTMLElement>('.site-header__panel')
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)')

  const isOpen = () =>
    !!header?.hasAttribute('data-open') && !header.hasAttribute('data-closing')

  // Com o menu aberto o resto da pagina fica coberto: sai da ordem de foco e
  // da arvore de acessibilidade para o leitor de tela nao navegar por tras.
  const setPageInert = (inert: boolean) => {
    for (const element of document.body.children) {
      if (element === header || element.tagName === 'SCRIPT') continue
      element.toggleAttribute('inert', inert)
    }
  }

  const finishClose = () => {
    header?.removeAttribute('data-open')
    header?.removeAttribute('data-closing')
    document.documentElement.classList.remove('has-menu-open')
  }

  // Aberto, o painel ocupa a tela a partir do topo. Ele cresce a partir de
  // onde o header esta e, ao fechar, encolhe de volta para la; por isso o
  // fechamento so termina no fim da animacao (`data-closing` ate entao).
  const setOpen = (open: boolean, instant = false) => {
    if (!header || !button) return
    header.style.setProperty(
      '--menu-from',
      `${header.getBoundingClientRect().top}px`,
    )

    if (open) {
      header.removeAttribute('data-closing')
      header.setAttribute('data-open', '')
      document.documentElement.classList.add('has-menu-open')
    } else if (header.hasAttribute('data-open')) {
      if (instant || reduceMotion.matches) finishClose()
      else header.setAttribute('data-closing', '')
    }

    button.setAttribute('aria-expanded', String(open))
    setPageInert(open)
  }

  panel?.addEventListener('animationend', (event) => {
    if (event.target === panel && header?.hasAttribute('data-closing')) {
      finishClose()
    }
  })

  button?.addEventListener('click', () => setOpen(!isOpen()))

  // Fecha ao navegar por um link do menu, com Esc e ao passar para o layout
  // desktop (onde o menu nao existe).
  header
    ?.querySelectorAll('.site-header__menu a')
    .forEach((link) => link.addEventListener('click', () => setOpen(false)))

  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape' || !isOpen()) return
    setOpen(false)
    button?.focus()
  })

  desktop.addEventListener('change', (event) => {
    if (event.matches) setOpen(false, true)
  })
</script>
