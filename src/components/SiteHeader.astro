---
/**
 * Barra do topo das paginas do site: hora e clima (preenchidos por
 * `public/js/*.js`) a esquerda; troca de idioma e de tema a direita.
 */
import LangSwitch from './LangSwitch.astro'
import type { Locale } from '../i18n/config'
import { ui } from '../i18n/ui'

interface Props {
  locale: Locale
  /** Caminho desta pagina no outro idioma. */
  switchPath: string
  class?: string
}

const { locale, switchPath, class: className } = Astro.props
const strings = ui[locale]
---

<div class:list={['desktop', className]}>
  <div class="personal-info">
    <p class="body--sm" id="hora"></p>
    <p class="body--sm" id="clima"></p>
  </div>
  <div class="site-controls">
    <LangSwitch locale={locale} href={switchPath} />
    <div class="theme-toggle" role="radiogroup" aria-label={strings.theme.label}>
      <div class="theme-toggle__thumb" aria-hidden="true"></div>
      <label class="theme-toggle__option" title={strings.theme.light}>
        <input type="radio" name="theme" value="light" aria-label={strings.theme.light} />
        <span class="theme-toggle__icon" aria-hidden="true">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="16"
            height="16"
            fill="none"
            viewBox="0 0 16 16"
          >
            <g clip-path="url(#a)">
              <path
                fill="var(--lui-color-secondary-icon-default)"
                d="M7.5 2.5V1a.5.5 0 0 1 1 0v1.5a.5.5 0 1 1-1 0ZM12 8a4 4 0 1 1-8 0 4 4 0 0 1 8 0Zm-1 0a3 3 0 1 0-6 0 3 3 0 0 0 6 0ZM3.646 4.354a.5.5 0 1 0 .708-.708l-1-1a.5.5 0 1 0-.708.708l1 1Zm0 7.292-1 1a.5.5 0 0 0 .708.708l1-1a.501.501 0 0 0-.708-.708ZM12 4.5a.5.5 0 0 0 .354-.146l1-1a.5.5 0 0 0-.708-.708l-1 1A.5.5 0 0 0 12 4.5Zm.354 7.146a.5.5 0 0 0-.708.708l1 1a.501.501 0 0 0 .708-.708l-1-1ZM3 8a.5.5 0 0 0-.5-.5H1a.5.5 0 0 0 0 1h1.5A.5.5 0 0 0 3 8Zm5 5a.5.5 0 0 0-.5.5V15a.5.5 0 0 0 1 0v-1.5A.5.5 0 0 0 8 13Zm7-5.5h-1.5a.5.5 0 0 0 0 1H15a.5.5 0 0 0 0-1Z"
              ></path>
            </g>
            <defs>
              <clipPath id="a">
                <path fill="#fff" d="M0 0h16v16H0z"></path>
              </clipPath>
            </defs>
          </svg>
        </span>
      </label>
      <label class="theme-toggle__option" title={strings.theme.dark}>
        <input type="radio" name="theme" value="dark" aria-label={strings.theme.dark} />
        <span class="theme-toggle__icon" aria-hidden="true">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="16"
            height="16"
            fill="none"
            viewBox="0 0 16 16"
          >
            <path
              fill="var(--lui-color-secondary-icon-default)"
              d="M14.596 8.89a.5.5 0 0 0-.5-.126 5.505 5.505 0 0 1-6.862-6.862.5.5 0 0 0-.625-.625A6.5 6.5 0 0 0 8.5 14a6.443 6.443 0 0 0 3.908-1.305 6.553 6.553 0 0 0 2.312-3.307.5.5 0 0 0-.124-.499Zm-2.79 3.006a5.5 5.5 0 1 1-5.74-9.327 6.507 6.507 0 0 0 7.366 7.364 5.562 5.562 0 0 1-1.626 1.963Z"
            ></path>
          </svg>
        </span>
      </label>
      <label class="theme-toggle__option" title={strings.theme.system}>
        <input type="radio" name="theme" value="system" aria-label={strings.theme.system} />
        <span class="theme-toggle__icon" aria-hidden="true">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="16"
            height="16"
            fill="none"
            viewBox="0 0 16 16"
          >
            <path
              fill="var(--lui-color-secondary-icon-default)"
              d="M13.5 2h-11A1.5 1.5 0 0 0 1 3.5v7A1.5 1.5 0 0 0 2.5 12h5v1.5H5a.5.5 0 0 0 0 1h6a.5.5 0 0 0 0-1H8.5V12h5a1.5 1.5 0 0 0 1.5-1.5v-7A1.5 1.5 0 0 0 13.5 2Zm.5 8.5a.5.5 0 0 1-.5.5h-11a.5.5 0 0 1-.5-.5v-7a.5.5 0 0 1 .5-.5h11a.5.5 0 0 1 .5.5v7Z"
            ></path>
          </svg>
        </span>
      </label>
    </div>
  </div>
</div>
