---
/**
 * Conteudo do <head> comum a todos os layouts: meta, Open Graph, Twitter,
 * canonical, alternates por idioma (hreflang), feed RSS, dados estruturados
 * (JSON-LD) e Google Tag Manager.
 *
 * `alternates` deve trazer o caminho desta mesma pagina em cada idioma em
 * que ela existe (veja `alternates()` em `src/i18n/config.ts`).
 */
import {
  alternates as buildAlternates,
  htmlLang,
  localePrefix,
  localizePath,
  ogLocale,
  otherLocale,
  type Locale,
} from '../i18n/config'
import { ui } from '../i18n/ui'
import { AUTHOR } from '../lib/seo'

interface Props {
  locale: Locale
  title: string
  description?: string
  keywords?: string
  /** Caminho canonico desta pagina, ja com o prefixo do idioma. */
  canonicalPath: string
  /** Caminhos desta pagina por idioma; omitido = mesma rota nos dois. */
  alternates?: Partial<Record<Locale, string>>
  image?: string
  /** Texto alternativo da imagem de compartilhamento. */
  imageAlt?: string
  robots?: string
  /** Data de publicacao (YYYY-MM-DD); presente so em posts do blog. */
  publishedTime?: string
  /** Tags do post, viram `article:tag`. */
  tags?: string[]
  /** Objetos JSON-LD (schema.org) a serem embutidos no <head>. */
  jsonLd?: object | object[]
  /** Caminho da versao em markdown desta pagina (posts do blog). */
  markdownPath?: string
}

const strings = ui[Astro.props.locale]

const {
  locale,
  title,
  description = strings.siteDescription,
  keywords = strings.keywords,
  canonicalPath,
  alternates,
  image = '/img/cover.png',
  imageAlt = title,
  robots = 'index, follow',
  publishedTime,
  tags = [],
  jsonLd,
  markdownPath,
} = Astro.props

const site = Astro.site ?? Astro.url
const canonicalUrl = new URL(canonicalPath, site).href
const imageUrl = new URL(image, site).href
const feedUrl = new URL(localizePath('/rss.xml', locale), site).href
const jsonLdList = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : []

// Sem `alternates`, assume que a pagina existe com a mesma rota nos dois
// idiomas: tira o prefixo do idioma atual e monta os dois caminhos.
const prefix = localePrefix(locale)
const basePath = prefix ? canonicalPath.replace(prefix, '') || '/' : canonicalPath
const links = buildAlternates(alternates ?? basePath)
const hasTranslation = links.some(
  (link) => link.hreflang === htmlLang[otherLocale(locale)],
)
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>{title}</title>

<meta name="title" content={title} />
<meta name="description" content={description} />
<meta name="keywords" content={keywords} />
<meta name="robots" content={robots} />
<meta name="author" content="Mateus Villain" />
<meta http-equiv="Content-Type" content="text/html; charset=utf-8" />

<meta property="og:site_name" content={strings.siteName} />
<meta property="og:type" content={publishedTime ? 'article' : 'website'} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={imageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="675" />
<meta property="og:image:alt" content={imageAlt} />
<meta property="og:locale" content={ogLocale[locale]} />
{
  hasTranslation && (
    <meta property="og:locale:alternate" content={ogLocale[otherLocale(locale)]} />
  )
}
{
  publishedTime && (
    <>
      <meta property="article:published_time" content={publishedTime} />
      <meta property="article:author" content={AUTHOR.url} />
      {tags.map((tag) => (
        <meta property="article:tag" content={tag} />
      ))}
    </>
  )
}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content="@mateusvillain" />
<meta name="twitter:creator" content="@mateusvillain" />
<meta name="twitter:url" content={canonicalUrl} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />
<meta name="twitter:image:alt" content={imageAlt} />

<link rel="canonical" href={canonicalUrl} />
{
  links.map((link) => (
    <link
      rel="alternate"
      hreflang={link.hreflang}
      href={new URL(link.path, site).href}
    />
  ))
}
<link rel="icon" type="image/x-icon" href="/img/favicon.png" />
<link
  rel="alternate"
  type="application/rss+xml"
  title={`${strings.siteName} - ${strings.blog}`}
  href={feedUrl}
/>
{
  markdownPath && (
    <link
      rel="alternate"
      type="text/markdown"
      href={new URL(markdownPath, site).href}
    />
  )
}
{
  jsonLdList.map((data) => (
    <script type="application/ld+json" set:html={JSON.stringify(data)} />
  ))
}

<script is:inline>
  ;(function (w, d, s, l, i) {
    w[l] = w[l] || []
    w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' })
    var f = d.getElementsByTagName(s)[0],
      j = d.createElement(s),
      dl = l != 'dataLayer' ? '&l=' + l : ''
    j.async = true
    j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i + dl
    f.parentNode.insertBefore(j, f)
  })(window, document, 'script', 'dataLayer', 'GTM-NTD9ZL6W')
</script>
