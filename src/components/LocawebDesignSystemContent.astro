---
import SiteHeader from './SiteHeader.astro'
import LwColorBoard from './LwColorBoard.astro'
import LwTypeScale from './LwTypeScale.astro'
import LwNotebook from './LwNotebook.astro'
import LwDesignCodeDiff from './LwDesignCodeDiff.astro'
import LwResults from './LwResults.astro'
import { htmlLang, localizePath, type Locale } from '../i18n/config'
import { ui } from '../i18n/ui'
import { caseLocaweb } from '../i18n/case-locaweb'

interface Props {
  locale: Locale
  switchPath: string
}

const { locale, switchPath } = Astro.props
const strings = caseLocaweb[locale]
const common = ui[locale]
const { overview, discovery, protected: locked } = strings

// Conteudo protegido vem do Sanity, com pt/en por campo (ver studio/).
const protectedLang = htmlLang[locale]
---

<a href="#main" class="skip-link">{common.skipLink}</a>
<SiteHeader locale={locale} switchPath={switchPath} liveInfo={false} />
<div class="body-container gap-fluid-80">
  <main id="main" class="project-main">
    <lui-breadcrumb>
      <lui-breadcrumb-item href={localizePath('/', locale)}
        >{common.home}</lui-breadcrumb-item
      >
    </lui-breadcrumb>
    <h1 class="title m-t-fluid-16 m-b-fluid-8">{strings.title}</h1>
    <dl class="project-details">
      <div class="info">
        <dt class="body--sm">{strings.company}</dt>
        <dd class="body--lg">{strings.companyName}</dd>
      </div>
      <div class="info">
        <dt class="body--sm">{strings.role}</dt>
        <dd class="body--lg">{strings.roleName}</dd>
      </div>
    </dl>
  </main>

  <!-- Overview -->
  <section class="project-section">
    <h2 class="headline">{overview.title}</h2>
    <div class="paragraph">
      <p class="body--lg">{overview.text}</p>
    </div>
    <h3 class="block-title">{overview.resultsTitle}</h3>
    <LwResults results={overview.results} />
  </section>

  <!-- Discovery -->
  <section class="project-section">
    <h2 class="headline">{discovery.title}</h2>
    <h3 class="block-title">{discovery.analysisTitle}</h3>
    <div class="paragraph">
      {discovery.analysis.map((text) => <p class="body--lg">{text}</p>)}
      <LwColorBoard locale={locale} label={discovery.colorTokensAlt} />
      {discovery.typography.map((text) => <p class="body--lg">{text}</p>)}
    </div>
    <div class="paragraph">
      <p class="body--lg">{discovery.typographyUsage}</p>
      <LwTypeScale locale={locale} label={discovery.typographyAlt} />
      <p class="body--lg">{discovery.fonts}</p>
    </div>

    <h3 class="block-title">{discovery.interviewsTitle}</h3>
    <div class="paragraph">
      {discovery.interviews.map((text) => <p class="body--lg">{text}</p>)}
    </div>

    <LwNotebook notes={discovery.interviewNotes} doodles={discovery.interviewDoodles} />

    <h3 class="block-title">{discovery.comparisonTitle}</h3>
    <div class="paragraph">
      {discovery.comparison.map((text) => <p class="body--lg">{text}</p>)}
    </div>

    <LwDesignCodeDiff locale={locale} />
  </section>

  <!-- Password -->
  <section id="password-box">
    <lui-card>
      <h2 class="headline">{locked.title}</h2>

      <lui-flex direction="column" gap="12">
        <lui-body variant="lg">{locked.text}</lui-body>
        <lui-body variant="lg" set:html={locked.noPasswordHtml}></lui-body>
        {locked.notice && <lui-body variant="lg">{locked.notice}</lui-body>}

        <form id="unlock-form" novalidate>
          <lui-flex direction="column" gap="24" class="m-t-fluid-8">
            <lui-input
              id="password"
              type="password"
              label={locked.passwordLabel}
              placeholder={locked.passwordPlaceholder}
              size="lg"
              required
              error-text={locked.passwordError}
            >
            </lui-input>
            <lui-button
              id="unlock"
              type="submit"
              variant="primary"
              data-link="unlock"
              block>{locked.unlock}</lui-button
            >
          </lui-flex>
        </form>
      </lui-flex>
    </lui-card>
  </section>

  <!-- Secret content -->
  <section
    id="protected-content"
    class="project-section-secret"
    lang={protectedLang}
  >
  </section>
</div>

<script
  src="/js/project-protected.js"
  data-slug="locaweb-design-system"
  data-locale={locale}
  data-msg-required={locked.required}
  data-msg-wrong-password={locked.wrongPassword}
  data-msg-load-error={locked.loadError}></script>
<script src="https://cdn.jsdelivr.net/npm/prismjs/prism.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/prismjs/components/prism-css.min.js"
></script>
<script
  src="https://cdn.jsdelivr.net/npm/prismjs/components/prism-javascript.min.js"
></script>
<script src="https://cdn.jsdelivr.net/npm/prismjs/components/prism-scss.min.js"
></script>
<script
  src="https://cdn.jsdelivr.net/npm/prismjs/components/prism-typescript.min.js"
></script>
<script src="https://cdn.jsdelivr.net/npm/prismjs/components/prism-json.min.js"
></script>
<script src="https://cdn.jsdelivr.net/npm/prismjs/components/prism-bash.min.js"
></script>
<script
  src="https://cdn.jsdelivr.net/npm/prismjs/components/prism-markdown.min.js"
></script>

<script>
  import '@lets-ui/components'
</script>
