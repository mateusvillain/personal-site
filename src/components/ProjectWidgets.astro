---
/**
 * Quadro de projetos — VERSAO 2.
 *
 * Segue o modelo do Figma (node 8299-326): tres cards com a mesma
 * anatomia — capa em cima, rodape com titulo, descricao e a seta.
 *
 *   locaweb — capa interativa: os componentes do design system (ver
 *             LocawebCover.astro)
 *   livro   — capa em imagem: a ilustracao da capa do livro
 *   letsui  — capa interativa: miniatura navegavel da documentacao
 *             (ver LetsUiCover.astro)
 *
 * A versao anterior do quadro esta guardada em ProjectWidgetsV1.astro.
 */
import LocawebCover from './LocawebCover.astro'
import LetsUiCover from './LetsUiCover.astro'

const { id = 'projects' } = Astro.props
const uid = (name) => `${id}-${name}`

const bookUrl = 'https://www.casadocodigo.com.br/products/livro-design-system'
const repoUrl = 'https://github.com/mateusvillain/lets-ui/'
---

<section class="pboard" aria-labelledby={uid('heading')}>
  <div class="pboard__header">
    <lui-heading
      variant="block-title"
      as="h2"
      id={uid('heading')}
      data-i18n="projects"></lui-heading>
    <button
      type="button"
      class="pboard__reset"
      data-reset-for={id}
      data-i18n="projects-reset"
      hidden></button>
  </div>

  <div class="pboard__stage" data-board={id}>
    <!-- Locaweb: capa larga com os componentes do sistema -->
    <article
      class="pcard pcard--locaweb"
      data-widget="locaweb"
      tabindex="0"
      aria-roledescription="card de projeto"
      aria-labelledby={uid('locaweb-title')}
    >
      <div class="pcard__cover">
        <LocawebCover id={uid('locaweb')} />
      </div>

      <footer class="pcard__foot">
        <div class="pcard__text">
          <lui-body
            variant="lg"
            as="h3"
            class="pcard__title"
            id={uid('locaweb-title')}
          >
            <a
              href="/case/locaweb-design-system/"
              data-link="locaweb-design-system"
              data-i18n="locaweb-title"></a>
          </lui-body>
          <lui-body
            variant="md"
            class="pcard__desc"
            data-i18n="locaweb-description"></lui-body>
        </div>

        <span class="pcard__go" aria-hidden="true">
          <ph-arrow-right size="24"></ph-arrow-right>
        </span>
      </footer>
    </article>

    <!-- Livro: a unica capa que continua sendo imagem -->
    <article
      class="pcard pcard--book"
      data-widget="book"
      tabindex="0"
      aria-roledescription="card de projeto"
      aria-labelledby={uid('book-title')}
    >
      <div class="pcard__cover pcard__cover--art">
        <img
          src="/img/dscover.png"
          width="494"
          height="410"
          loading="lazy"
          draggable="false"
          alt=""
        />
      </div>

      <footer class="pcard__foot">
        <div class="pcard__text">
          <lui-body
            variant="lg"
            as="h3"
            class="pcard__title"
            id={uid('book-title')}
          >
            <a
              href={bookUrl}
              target="_blank"
              rel="noopener"
              data-link="book"
              data-i18n="book-title"></a>
          </lui-body>
          <lui-body
            variant="md"
            class="pcard__desc"
            data-i18n="book-description"></lui-body>
        </div>

        <span class="pcard__go" aria-hidden="true">
          <ph-arrow-up-right size="24"></ph-arrow-up-right>
        </span>
      </footer>
    </article>

    <!-- Let's UI: capa larga com a miniatura da documentacao -->
    <article
      class="pcard pcard--letsui"
      data-widget="letsui"
      tabindex="0"
      aria-roledescription="card de projeto"
      aria-labelledby={uid('letsui-title')}
    >
      <div class="pcard__cover">
        <LetsUiCover id={uid('letsui')} />
      </div>

      <footer class="pcard__foot">
        <div class="pcard__text">
          <lui-body
            variant="lg"
            as="h3"
            class="pcard__title"
            id={uid('letsui-title')}
          >
            <a href={repoUrl} target="_blank" rel="noopener" data-link="github-lets-ui">
              Let's UI
            </a>
            <span class="pcard__badge" data-stat="version" hidden></span>
          </lui-body>
          <lui-body
            variant="md"
            class="pcard__desc"
            data-i18n="letsui-description"></lui-body>
        </div>

        <span class="pcard__go" aria-hidden="true">
          <ph-arrow-up-right size="24"></ph-arrow-up-right>
        </span>
      </footer>
    </article>
  </div>
</section>

<script>
  /* ---------------------------------------------------------------------
     Arrasto livre dos cards: mouse, caneta e toque.
     - mouse: arrasta a partir de qualquer ponto do card (menos controles)
     - toque/caneta: pressione e segure por um instante para "levantar" o
       card; assim o scroll vertical da pagina continua funcionando
  --------------------------------------------------------------------- */
  const DRAG_THRESHOLD = 5
  const HOLD_DELAY = 260
  const HOLD_TOLERANCE = 8
  const GUTTER = 8
  const STAGE_SLACK = 32
  const STEP = 12

  document.querySelectorAll('.pboard__stage').forEach((board) => {
    const boardId = board.dataset.board
    const cards = Array.from(board.querySelectorAll('.pcard'))
    const resetButton = document.querySelector(`[data-reset-for="${boardId}"]`)
    const STORAGE_KEY = `card-positions:${boardId}`

    let topLayer = 1

    const positions = (() => {
      try {
        return JSON.parse(localStorage.getItem(STORAGE_KEY) || '{}')
      } catch {
        return {}
      }
    })()

    const syncResetButton = () => {
      if (resetButton) resetButton.hidden = !Object.keys(positions).length
    }

    const savePositions = () => {
      try {
        localStorage.setItem(STORAGE_KEY, JSON.stringify(positions))
      } catch {
        /* modo privado: apenas nao persiste */
      }
      syncResetButton()
    }

    const apply = (card, x, y) => {
      card.style.setProperty('--card-x', `${Math.round(x)}px`)
      card.style.setProperty('--card-y', `${Math.round(y)}px`)
    }

    const clamp = (card, x, y) => {
      const rect = card.getBoundingClientRect()
      const stage = board.getBoundingClientRect()
      const current = positions[card.dataset.widget] || { x: 0, y: 0 }
      // bordas do card sem o deslocamento atual
      const left = rect.left - current.x
      const right = rect.right - current.x
      const top = rect.top - current.y
      const bottom = rect.bottom - current.y
      // horizontal: dentro da janela, para nao criar rolagem lateral
      const minX = GUTTER - left
      const maxX = window.innerWidth - GUTTER - right
      // vertical: qualquer ponto do quadro, igual para todos os cards
      const minY = stage.top - STAGE_SLACK - top
      const maxY = stage.bottom + STAGE_SLACK - bottom
      return {
        x: minX > maxX ? 0 : Math.min(Math.max(x, minX), maxX),
        y: minY > maxY ? 0 : Math.min(Math.max(y, minY), maxY),
      }
    }

    const move = (card, x, y, persist) => {
      const next = clamp(card, x, y)
      positions[card.dataset.widget] = next
      apply(card, next.x, next.y)
      if (persist) savePositions()
    }

    cards.forEach((card) => {
      const saved = positions[card.dataset.widget]
      if (saved) apply(card, saved.x, saved.y)

      let pointerId = null
      let startX = 0
      let startY = 0
      let originX = 0
      let originY = 0
      let armed = false
      let dragging = false
      let moved = false
      let holdTimer = null

      const arm = (event) => {
        armed = true
        moved = false
        pointerId = event.pointerId
        startX = event.clientX
        startY = event.clientY
        const current = positions[card.dataset.widget] || { x: 0, y: 0 }
        originX = current.x
        originY = current.y
      }

      const lift = () => {
        dragging = true
        card.style.zIndex = String(++topLayer)
        card.classList.add('is-dragging')
        if (pointerId !== null) card.setPointerCapture(pointerId)
      }

      card.addEventListener('pointerdown', (event) => {
        if (event.pointerType === 'mouse' && event.button !== 0) return
        // os controles das capas interativas vem antes do arrasto
        if (
          event.target.closest(
            'a, button, input, label, select, textarea, [data-no-drag]'
          )
        )
          return

        arm(event)

        if (event.pointerType === 'mouse') {
          // no mouse o arrasto comeca assim que o cursor se move
          card.setPointerCapture(event.pointerId)
          return
        }

        // toque e caneta: pressionar e segurar levanta o card
        holdTimer = window.setTimeout(() => {
          holdTimer = null
          if (armed) lift()
        }, HOLD_DELAY)
      })

      card.addEventListener('pointermove', (event) => {
        if (!armed || event.pointerId !== pointerId) return
        const dx = event.clientX - startX
        const dy = event.clientY - startY
        const distance = Math.hypot(dx, dy)

        if (holdTimer !== null) {
          // rolou a pagina antes do tempo: nao era um arrasto
          if (distance > HOLD_TOLERANCE) {
            window.clearTimeout(holdTimer)
            holdTimer = null
            armed = false
          }
          return
        }

        if (!dragging) {
          if (distance < DRAG_THRESHOLD) return
          lift()
        }

        moved = true
        event.preventDefault()
        move(card, originX + dx, originY + dy, false)
      })

      // impede o scroll nativo enquanto o card estiver levantado
      card.addEventListener(
        'touchmove',
        (event) => {
          if (dragging) event.preventDefault()
        },
        { passive: false }
      )

      const endDrag = (event) => {
        if (event.pointerId !== pointerId) return
        if (holdTimer !== null) {
          window.clearTimeout(holdTimer)
          holdTimer = null
        }
        if (dragging) {
          card.classList.remove('is-dragging')
          if (card.hasPointerCapture(pointerId)) {
            card.releasePointerCapture(pointerId)
          }
          if (moved) savePositions()
        }
        armed = false
        dragging = false
        pointerId = null
      }

      card.addEventListener('pointerup', endDrag)
      card.addEventListener('pointercancel', endDrag)

      // um arrasto nao deve disparar o link que estiver sob o cursor
      card.addEventListener(
        'click',
        (event) => {
          if (!moved) return
          event.preventDefault()
          event.stopPropagation()
          moved = false
        },
        true
      )

      card.addEventListener('dragstart', (event) => event.preventDefault())

      // teclado: setas movem o card em foco, Escape devolve ao lugar
      card.addEventListener('keydown', (event) => {
        if (event.target !== card) return
        const current = positions[card.dataset.widget] || { x: 0, y: 0 }
        const step = event.shiftKey ? STEP * 4 : STEP

        if (event.key === 'Escape') {
          delete positions[card.dataset.widget]
          apply(card, 0, 0)
          savePositions()
          return
        }

        const deltas = {
          ArrowUp: [0, -step],
          ArrowDown: [0, step],
          ArrowLeft: [-step, 0],
          ArrowRight: [step, 0],
        }
        const delta = deltas[event.key]
        if (!delta) return

        event.preventDefault()
        card.style.zIndex = String(++topLayer)
        move(card, current.x + delta[0], current.y + delta[1], true)
      })
    })

    resetButton?.addEventListener('click', () => {
      cards.forEach((card) => {
        delete positions[card.dataset.widget]
        apply(card, 0, 0)
        card.style.zIndex = ''
      })
      topLayer = 1
      savePositions()
    })

    // ao redimensionar, garante que nenhum card fique fora da tela
    let resizeTimer
    window.addEventListener('resize', () => {
      window.clearTimeout(resizeTimer)
      resizeTimer = window.setTimeout(() => {
        cards.forEach((card) => {
          const current = positions[card.dataset.widget]
          if (current) move(card, current.x, current.y, false)
        })
      }, 150)
    })

    syncResetButton()
  })

  /* ---------------------------------------------------------------------
     Versao publicada do Let's UI no npm, exibida ao lado do titulo.
     Falha em silencio: o selo so aparece quando ha resposta.
  --------------------------------------------------------------------- */
  const STATS_CACHE = 'letsui-stats'
  const STATS_TTL = 1000 * 60 * 60 * 6

  const showVersion = (version) => {
    document.querySelectorAll('[data-stat="version"]').forEach((el) => {
      el.textContent = `v${version}`
      el.hidden = false
    })
  }

  const readCache = () => {
    try {
      const cached = JSON.parse(sessionStorage.getItem(STATS_CACHE) || 'null')
      if (cached && Date.now() - cached.at < STATS_TTL) return cached.stats
    } catch {
      /* ignora cache invalido */
    }
    return null
  }

  const loadVersion = async () => {
    const cached = readCache()
    if (cached?.version) {
      showVersion(cached.version)
      return
    }

    const response = await fetch(
      'https://registry.npmjs.org/@lets-ui/components/latest'
    ).catch(() => null)
    if (!response?.ok) return

    const payload = await response.json().catch(() => null)
    if (!payload?.version) return

    showVersion(payload.version)

    try {
      sessionStorage.setItem(
        STATS_CACHE,
        JSON.stringify({ at: Date.now(), stats: { version: payload.version } })
      )
    } catch {
      /* modo privado: apenas nao guarda */
    }
  }

  if (document.querySelector('[data-stat="version"]')) loadVersion()
</script>
