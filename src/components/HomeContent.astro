---
import { getCollection } from 'astro:content'
import ProjectWidgets from './ProjectWidgets.astro'
import lang from '../../public/lang/en.json'

const months = [
  'Jan',
  'Fev',
  'Mar',
  'Abr',
  'Mai',
  'Jun',
  'Jul',
  'Ago',
  'Set',
  'Out',
  'Nov',
  'Dez',
]

const latestPosts = (await getCollection('blog'))
  .sort(
    (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime(),
  )
  .slice(0, 3)

function parsePostDate(value: string) {
  const [year, month, day] = value.split('-').map(Number)
  return new Date(year, month - 1, day)
}
---

<a href="#main" class="skip-link">Ir para o conteúdo principal</a>
<div class="body-container">
  <lui-stack gap="80">
    <div class="desktop">
      <div class="personal-info">
        <lui-body variant="sm" id="hora"></lui-body>
        <lui-body variant="sm" id="clima"></lui-body>
        <lui-body variant="sm" id="spotify"></lui-body>
      </div>
      <div class="site-controls">
        <button
          type="button"
          class="body--sm link"
          id="lang-switch"
          data-i18n="language"
          data-link="language"
          set:html={lang.language}></button>
        <label class="theme-toggle" aria-label="Alternar tema">
          <input type="checkbox" id="theme-toggle" />
          <div class="theme-toggle__track">
            <div class="theme-toggle__thumb"></div>
            <div class="theme-toggle__icon theme-toggle__icon--sun">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="16"
                height="16"
                fill="none"
                viewBox="0 0 16 16"
              >
                <g clip-path="url(#a)">
                  <path
                    fill="var(--lui-color-secondary-icon-default)"
                    d="M7.5 2.5V1a.5.5 0 0 1 1 0v1.5a.5.5 0 1 1-1 0ZM12 8a4 4 0 1 1-8 0 4 4 0 0 1 8 0Zm-1 0a3 3 0 1 0-6 0 3 3 0 0 0 6 0ZM3.646 4.354a.5.5 0 1 0 .708-.708l-1-1a.5.5 0 1 0-.708.708l1 1Zm0 7.292-1 1a.5.5 0 0 0 .708.708l1-1a.501.501 0 0 0-.708-.708ZM12 4.5a.5.5 0 0 0 .354-.146l1-1a.5.5 0 0 0-.708-.708l-1 1A.5.5 0 0 0 12 4.5Zm.354 7.146a.5.5 0 0 0-.708.708l1 1a.501.501 0 0 0 .708-.708l-1-1ZM3 8a.5.5 0 0 0-.5-.5H1a.5.5 0 0 0 0 1h1.5A.5.5 0 0 0 3 8Zm5 5a.5.5 0 0 0-.5.5V15a.5.5 0 0 0 1 0v-1.5A.5.5 0 0 0 8 13Zm7-5.5h-1.5a.5.5 0 0 0 0 1H15a.5.5 0 0 0 0-1Z"
                  ></path>
                </g>
                <defs>
                  <clipPath id="a">
                    <path fill="#fff" d="M0 0h16v16H0z"></path>
                  </clipPath>
                </defs>
              </svg>
            </div>
            <div class="theme-toggle__icon theme-toggle__icon--moon">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="16"
                height="16"
                fill="none"
                viewBox="0 0 16 16"
              >
                <path
                  fill="var(--lui-color-secondary-icon-default)"
                  d="M14.596 8.89a.5.5 0 0 0-.5-.126 5.505 5.505 0 0 1-6.862-6.862.5.5 0 0 0-.625-.625A6.5 6.5 0 0 0 8.5 14a6.443 6.443 0 0 0 3.908-1.305 6.553 6.553 0 0 0 2.312-3.307.5.5 0 0 0-.124-.499Zm-2.79 3.006a5.5 5.5 0 1 1-5.74-9.327 6.507 6.507 0 0 0 7.366 7.364 5.562 5.562 0 0 1-1.626 1.963Z"
                ></path>
              </svg>
            </div>
          </div>
        </label>
      </div>
    </div>

    <main id="main" class="hero">
      <lui-stack gap="80">
      <lui-flex direction="column" wrap="nowrap" gap="16" align="left">
        <lui-image
          src="img/mtsvlln.jpg"
          width="88px"
          aspect-ratio="1/1"
          radius="md"
          alt="Fotografia de Mateus Villain: Homem de barba cheia e cabeça raspada, usando óculos de armação arredondada, olha diretamente para a câmera. Ele segura um copo de café com tampa. A foto tem estilo de polaroid, com fundo desfocado em ambiente interno."
        ></lui-image>

        <div>
          <lui-heading variant="block-title" as="h1">Mateus Villain</lui-heading
          >
          <lui-body variant="lg" data-i18n="role" italic set:html={lang.role}
          ></lui-body>
        </div>

        <lui-body variant="lg" data-i18n="short-bio" set:html={lang['short-bio']}
        ></lui-body>
        <lui-body
          variant="lg"
          data-i18n="short-bio-2"
          set:html={lang['short-bio-2']}></lui-body>
        <lui-body
          variant="lg"
          data-i18n="short-bio-3"
          set:html={lang['short-bio-3']}></lui-body>
      </lui-flex>

      <a
        rel="me"
        href="https://mastodon.social/@mateusvillain"
        style="display: none;">Mastodon</a
      >

      <ProjectWidgets />

      <section>
        <lui-flex direction="row" justify="space-between" align="center">
          <lui-heading
            variant="block-title"
            as="h2"
            data-i18n="blog-title"
            set:html={lang['blog-title']}></lui-heading>
          <lui-link
            href="/blog/"
            data-link="blog"
            data-i18n="blog-link"
            set:html={lang['blog-link']}></lui-link>
        </lui-flex>
        <ul class="no-list">
          {
            latestPosts.map((post) => {
              const date = parsePostDate(post.data.date)
              const formattedDate = `${String(date.getDate()).padStart(2, '0')} ${months[date.getMonth()]} ${date.getFullYear()}`
              return (
                <li>
                  <a href={`/blog/${post.slug}/`}>
                    <article class="flex justify-between items-baseline gap-fluid-16 interaction-item">
                      <lui-body variant="lg" as="h3">
                        {post.data.title}
                      </lui-body>
                      <time class="body--md space-nowrap">{formattedDate}</time>
                    </article>
                  </a>
                </li>
              )
            })
          }
        </ul>
      </section>
      </lui-stack>
    </main>
  </lui-stack>
</div>

<script>
  import '@lets-ui/components'
</script>
