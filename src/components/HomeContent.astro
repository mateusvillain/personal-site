---
import ProjectWidgets from './ProjectWidgets.astro'
import SiteHeader from './SiteHeader.astro'
import NowPlaying from './NowPlaying.astro'
import { localizePath, type Locale } from '../i18n/config'
import { ui } from '../i18n/ui'
import { home } from '../i18n/home'
import { formatPostDate, getPosts, postPath } from '../lib/posts'

interface Props {
  locale: Locale
  switchPath: string
}

const { locale, switchPath } = Astro.props
const strings = home[locale]
const common = ui[locale]

const latestPosts = (await getPosts(locale)).slice(0, 3)
---

<a href="#main" class="skip-link">{common.skipLink}</a>
<SiteHeader locale={locale} switchPath={switchPath} />
<div class="body-container">
  <lui-stack gap="80">
    <main id="main" class="hero">
      <lui-stack gap="80">
        {/*
          Hero em HTML puro: com <lui-body>/<lui-image> o texto e a foto so
          apareciam depois do JS dos web components (LCP ~3s).
        */}
        <div class="hero__intro">
          <div class="profile-photo">
            <img
              class="profile-photo__img radius-md"
              src="/img/mtsvlln.jpg"
              width="88"
              height="88"
              fetchpriority="high"
              alt={strings.photoAlt}
            />
            <NowPlaying locale={locale} />
          </div>

          <div>
            <h1 class="block-title text--color-heading">Mateus Villain</h1>
            <p class="body--lg text--color-body text--style-italic">
              {strings.role}
            </p>
          </div>

          <p class="body--lg text--color-body" set:html={strings.shortBioHtml} />
          <p class="body--lg text--color-body" set:html={strings.shortBio2Html} />
          <p class="body--lg text--color-body" set:html={strings.shortBio3Html} />
        </div>

        <a
          rel="me"
          href="https://mastodon.social/@mateusvillain"
          style="display: none;">Mastodon</a
        >

        <ProjectWidgets locale={locale} />

        <section>
          <lui-flex direction="row" justify="space-between" align="center">
            <h2 class="block-title text--color-heading">
              {strings.blogTitle}
            </h2>
            <lui-link href={localizePath('/blog/', locale)} data-link="blog"
              >{strings.blogLink}</lui-link
            >
          </lui-flex>
          <div data-hover-highlight>
            <ul class="no-list">
              {
                latestPosts.map((post) => (
                  <li>
                    <a href={postPath(post)}>
                      <article class="flex justify-between items-baseline gap-fluid-16 interaction-item">
                        <h3 class="body--lg text--color-body">
                          {post.data.title}
                        </h3>
                        <time class="body--md space-nowrap" datetime={post.data.date}>
                          {formatPostDate(post.data.date, locale)}
                        </time>
                      </article>
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>
        </section>
      </lui-stack>
    </main>
  </lui-stack>
</div>

<script>
  import '@lets-ui/components'
  import { initHoverHighlight } from '../lib/hover-highlight'

  document
    .querySelectorAll<HTMLElement>('[data-hover-highlight]')
    .forEach((list) => initHoverHighlight(list, '.interaction-item'))
</script>
