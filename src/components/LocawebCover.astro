---
/**
 * Capa do card do Locaweb Design System.
 *
 * Em vez de uma imagem, os proprios componentes do sistema: a escala de
 * cor, os botoes nas tres enfases, os icone-botoes, as abas e os
 * controles de selecao. Tudo responde a cursor e toque.
 *
 * Nao usa JavaScript: abas, toggles, radios e checkboxes sao inputs
 * nativos, o estado vive no DOM e o desenho e feito no CSS.
 */
const { id = 'lw' } = Astro.props
const uid = (name) => `${id}-${name}`

// escala de cor: a mesma opacidade aplicada sobre o vermelho da marca
const scale = [10, 30, 60, 80, 100]
const tabs = ['Tab 1', 'Tab 2', 'Tab 3']
---

<div class="lwcover" role="group" aria-label="Locaweb Design System">
  <div class="lwcover__stack">
    <!-- escala de cor: cada degrau e um botao que revela o seu valor -->
    <ul class="lwscale">
      {
        scale.map((step) => (
          <li>
            <button
              type="button"
              class="lwscale__step"
              style={`--step: ${step / 100}`}
            >
              <span class="lwscale__value">{step}</span>
            </button>
          </li>
        ))
      }
    </ul>

    <div class="lwrow">
      <button type="button" class="lwbtn lwbtn--primary">Button</button>
      <button type="button" class="lwbtn lwbtn--secondary">Button</button>
      <button type="button" class="lwbtn lwbtn--ghost">Button</button>

      <button
        type="button"
        class="lwbtn lwbtn--primary lwbtn--icon"
        aria-label="Fechar"
      >
        <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
          <path
            d="M14.4605 13.6645C14.5127 13.7168 14.5542 13.7788 14.5825 13.8471C14.6108 13.9154 14.6253 13.9886 14.6253 14.0625C14.6253 14.1364 14.6108 14.2096 14.5825 14.2779C14.5542 14.3462 14.5127 14.4082 14.4605 14.4605C14.4082 14.5127 14.3462 14.5542 14.2779 14.5825C14.2096 14.6108 14.1364 14.6253 14.0625 14.6253C13.9886 14.6253 13.9154 14.6108 13.8471 14.5825C13.7788 14.5542 13.7168 14.5127 13.6645 14.4605L9 9.79523L4.33547 14.4605C4.22992 14.566 4.08677 14.6253 3.9375 14.6253C3.78823 14.6253 3.64508 14.566 3.53953 14.4605C3.43398 14.3549 3.37469 14.2118 3.37469 14.0625C3.37469 13.9132 3.43398 13.7701 3.53953 13.6645L8.20477 9L3.53953 4.33547C3.43398 4.22992 3.37469 4.08677 3.37469 3.9375C3.37469 3.78823 3.43398 3.64508 3.53953 3.53953C3.64508 3.43398 3.78823 3.37469 3.9375 3.37469C4.08677 3.37469 4.22992 3.43398 4.33547 3.53953L9 8.20477L13.6645 3.53953C13.7701 3.43398 13.9132 3.37469 14.0625 3.37469C14.2118 3.37469 14.3549 3.43398 14.4605 3.53953C14.566 3.64508 14.6253 3.78823 14.6253 3.9375C14.6253 4.08677 14.566 4.22992 14.4605 4.33547L9.79523 9L14.4605 13.6645Z"
            fill="currentColor"></path>
        </svg>
      </button>

      <button
        type="button"
        class="lwbtn lwbtn--secondary lwbtn--icon"
        aria-label="Avancar"
      >
        <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
          <path
            d="M15.5855 9.39797L10.523 14.4605C10.4174 14.566 10.2743 14.6253 10.125 14.6253C9.97573 14.6253 9.83258 14.566 9.72703 14.4605C9.62148 14.3549 9.56219 14.2118 9.56219 14.0625C9.56219 13.9132 9.62148 13.7701 9.72703 13.6645L13.8298 9.5625H2.8125C2.66332 9.5625 2.52024 9.50324 2.41475 9.39775C2.30926 9.29226 2.25 9.14918 2.25 9C2.25 8.85082 2.30926 8.70774 2.41475 8.60225C2.52024 8.49676 2.66332 8.4375 2.8125 8.4375H13.8298L9.72703 4.33547C9.62148 4.22992 9.56219 4.08677 9.56219 3.9375C9.56219 3.78823 9.62148 3.64508 9.72703 3.53953C9.83258 3.43398 9.97573 3.37469 10.125 3.37469C10.2743 3.37469 10.4174 3.43398 10.523 3.53953L15.5855 8.60203C15.6378 8.65427 15.6793 8.71631 15.7076 8.7846C15.7359 8.85288 15.7504 8.92608 15.7504 9C15.7504 9.07392 15.7359 9.14712 15.7076 9.2154C15.6793 9.28369 15.6378 9.34573 15.5855 9.39797Z"
            fill="currentColor"></path>
        </svg>
      </button>

      <button
        type="button"
        class="lwbtn lwbtn--ghost lwbtn--icon"
        aria-label="Menu"
      >
        <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
          <path
            d="M15.75 9C15.75 9.14918 15.6907 9.29226 15.5852 9.39775C15.4798 9.50324 15.3367 9.5625 15.1875 9.5625H2.8125C2.66332 9.5625 2.52024 9.50324 2.41475 9.39775C2.30926 9.29226 2.25 9.14918 2.25 9C2.25 8.85082 2.30926 8.70774 2.41475 8.60225C2.52024 8.49676 2.66332 8.4375 2.8125 8.4375H15.1875C15.3367 8.4375 15.4798 8.49676 15.5852 8.60225C15.6907 8.70774 15.75 8.85082 15.75 9ZM2.8125 5.0625H15.1875C15.3367 5.0625 15.4798 5.00324 15.5852 4.89775C15.6907 4.79226 15.75 4.64918 15.75 4.5C15.75 4.35082 15.6907 4.20774 15.5852 4.10225C15.4798 3.99676 15.3367 3.9375 15.1875 3.9375H2.8125C2.66332 3.9375 2.52024 3.99676 2.41475 4.10225C2.30926 4.20774 2.25 4.35082 2.25 4.5C2.25 4.64918 2.30926 4.79226 2.41475 4.89775C2.52024 5.00324 2.66332 5.0625 2.8125 5.0625ZM15.1875 12.9375H2.8125C2.66332 12.9375 2.52024 12.9968 2.41475 13.1023C2.30926 13.2077 2.25 13.3508 2.25 13.5C2.25 13.6492 2.30926 13.7923 2.41475 13.8977C2.52024 14.0032 2.66332 14.0625 2.8125 14.0625H15.1875C15.3367 14.0625 15.4798 14.0032 15.5852 13.8977C15.6907 13.7923 15.75 13.6492 15.75 13.5C15.75 13.3508 15.6907 13.2077 15.5852 13.1023C15.4798 12.9968 15.3367 12.9375 15.1875 12.9375Z"
            fill="currentColor"></path>
        </svg>
      </button>

      <!-- abas: radios nativos, o sublinhado segue o :checked -->
      <div class="lwtabs" role="group" aria-label="Tabs">
        {
          tabs.map((label, index) => (
            <span class="lwtabs__item">
              <input
                type="radio"
                name={uid('tabs')}
                id={uid(`tab-${index}`)}
                checked={index === 0}
              />
              <label for={uid(`tab-${index}`)}>{label}</label>
            </span>
          ))
        }
      </div>
    </div>

    <div class="lwrow lwrow--controls">
      <span class="lwswitch">
        <input type="checkbox" id={uid('switch-a')} aria-label="Switch" />
        <label for={uid('switch-a')}></label>
      </span>
      <span class="lwswitch">
        <input
          type="checkbox"
          id={uid('switch-b')}
          checked
          aria-label="Switch selecionado"
        />
        <label for={uid('switch-b')}></label>
      </span>

      <span class="lwradio">
        <input
          type="radio"
          name={uid('choice')}
          id={uid('radio-a')}
          aria-label="Radio"
        />
        <label for={uid('radio-a')}></label>
      </span>
      <span class="lwradio">
        <input
          type="radio"
          name={uid('choice')}
          id={uid('radio-b')}
          checked
          aria-label="Radio selecionado"
        />
        <label for={uid('radio-b')}></label>
      </span>

      <span class="lwcheck">
        <input type="checkbox" id={uid('check-a')} aria-label="Checkbox" />
        <label for={uid('check-a')}>
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path
              d="M14.3538 4.85375L6.35375 12.8538C6.30731 12.9002 6.25217 12.9371 6.19147 12.9623C6.13077 12.9874 6.06571 13.0004 6 13.0004C5.93429 13.0004 5.86923 12.9874 5.80853 12.9623C5.74783 12.9371 5.69269 12.9002 5.64625 12.8538L2.14625 9.35375C2.05243 9.25993 1.99972 9.13268 1.99972 9C1.99972 8.86732 2.05243 8.74007 2.14625 8.64625C2.24007 8.55243 2.36732 8.49972 2.5 8.49972C2.63268 8.49972 2.75993 8.55243 2.85375 8.64625L6 11.7931L13.6463 4.14625C13.7401 4.05243 13.8673 3.99972 14 3.99972C14.1327 3.99972 14.2599 4.05243 14.3538 4.14625C14.4476 4.24007 14.5003 4.36732 14.5003 4.5C14.5003 4.63268 14.4476 4.75993 14.3538 4.85375Z"
              fill="currentColor"></path>
          </svg>
        </label>
      </span>
      <span class="lwcheck">
        <input
          type="checkbox"
          id={uid('check-b')}
          checked
          aria-label="Checkbox marcado"
        />
        <label for={uid('check-b')}>
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path
              d="M14.3538 4.85375L6.35375 12.8538C6.30731 12.9002 6.25217 12.9371 6.19147 12.9623C6.13077 12.9874 6.06571 13.0004 6 13.0004C5.93429 13.0004 5.86923 12.9874 5.80853 12.9623C5.74783 12.9371 5.69269 12.9002 5.64625 12.8538L2.14625 9.35375C2.05243 9.25993 1.99972 9.13268 1.99972 9C1.99972 8.86732 2.05243 8.74007 2.14625 8.64625C2.24007 8.55243 2.36732 8.49972 2.5 8.49972C2.63268 8.49972 2.75993 8.55243 2.85375 8.64625L6 11.7931L13.6463 4.14625C13.7401 4.05243 13.8673 3.99972 14 3.99972C14.1327 3.99972 14.2599 4.05243 14.3538 4.14625C14.4476 4.24007 14.5003 4.36732 14.5003 4.5C14.5003 4.63268 14.4476 4.75993 14.3538 4.85375Z"
              fill="currentColor"></path>
          </svg>
        </label>
      </span>
    </div>
  </div>
</div>
