---
/**
 * Conteudo da 404 em um idioma. A pagina 404 e uma so (a Vercel serve
 * `dist/404.html` para qualquer URL desconhecida), entao ela renderiza este
 * bloco duas vezes e mostra apenas o do idioma da URL pedida.
 */
import LangSwitch from './LangSwitch.astro'
import { localizePath, otherLocale, type Locale } from '../i18n/config'
import { ui } from '../i18n/ui'
import { notFound } from '../i18n/not-found'

interface Props {
  locale: Locale
  hidden?: boolean
}

const { locale, hidden = false } = Astro.props
const strings = notFound[locale]
const common = ui[locale]
---

<div data-locale={locale} hidden={hidden}>
  <a href={`#main-${locale}`} class="skip-link">{common.skipLink}</a>
  <LangSwitch
    locale={locale}
    href={localizePath('/', otherLocale(locale))}
    id={`lang-switch-${locale}`}
    class=""
  />
  <div class="body-container">
    <main id={`main-${locale}`} class="content">
      <h1>{strings.title}</h1>
      <p>{strings.description}</p>
      <ul>
        {strings.items.map((item) => <li>{item}</li>)}
      </ul>

      <nav>
        <p>
          <a href={localizePath('/', locale)}>{strings.homeLink}</a>
        </p>
        <p>
          <a href={localizePath('/case/locaweb-design-system/', locale)}
            >{strings.caseLink}</a
          >
        </p>
      </nav>
    </main>
  </div>
</div>
