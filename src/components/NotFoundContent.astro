---
import lang from '../../public/lang/en.json'
---

<a href="#main" class="skip-link">Ir para o conteúdo principal</a>
<button
  type="button"
  id="lang-switch"
  data-i18n="language"
  data-link="language"
  set:html={lang.language}></button>
<div class="body-container">
  <main id="main" class="content">
    <h1 data-i18n="404-title" set:html={lang['404-title']}></h1>
    <p data-i18n="404-description" set:html={lang['404-description']}></p>
    <ul>
      <li data-i18n="404-item-1" set:html={lang['404-item-1']}></li>
      <li data-i18n="404-item-2" set:html={lang['404-item-2']}></li>
      <li data-i18n="404-item-3" set:html={lang['404-item-3']}></li>
    </ul>

    <nav>
      <p>
        <a href="/" data-i18n="404-link-1" set:html={lang['404-link-1']}></a>
      </p>
      <p>
        <a href="/case/locaweb-design-system/">Locaweb Design System</a>
      </p>
    </nav>
  </main>
</div>
