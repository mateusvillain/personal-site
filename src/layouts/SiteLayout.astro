---
import '@lets-ui/styles'
import Scripts from '../components/Scripts.astro'
import CookieConsent from '../components/CookieConsent.astro'
import SeoHead from '../components/SeoHead.astro'
import { htmlLang, type Locale } from '../i18n/config'

interface Props {
  locale: Locale
  title: string
  description?: string
  keywords?: string
  /** Caminho canonico desta pagina, ja com o prefixo do idioma. */
  canonicalPath: string
  /** Caminhos desta pagina por idioma; omitido = mesma rota nos dois. */
  alternates?: Partial<Record<Locale, string>>
  image?: string
  jsonLd?: object | object[]
  bodyClass?: string
  brand?: string
  includeScripts?: boolean
}

const {
  locale,
  title,
  description,
  keywords,
  canonicalPath,
  alternates,
  image,
  jsonLd,
  bodyClass = 'm-b-fluid-80',
  brand = 'mateus-villain',
  includeScripts = true,
} = Astro.props
---

<!doctype html>
<html lang={htmlLang[locale]} data-brand={brand}>
  <head>
    <SeoHead
      locale={locale}
      title={title}
      description={description}
      keywords={keywords}
      canonicalPath={canonicalPath}
      alternates={alternates}
      image={image}
      jsonLd={jsonLd}
    />

    <link rel="stylesheet" href="/style.css" />
    <link
      rel="preload"
      href="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/themes/prism.min.css"
      as="style"
      onload="this.rel = 'stylesheet'"
    />
    <link
      rel="preload"
      href="/fonts/Geist-VariableFont_wght.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/GoogleSansCode-VariableFont_wght.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
  </head>
  <body class={bodyClass}>
    <slot />
    {includeScripts && <Scripts />}
    <CookieConsent locale={locale} />
    <script>
      import '@phosphor-icons/webcomponents'
    </script>
  </body>
</html>
