---
import ConsentScript from '../components/ConsentScript.astro'
import CookieConsent from '../components/CookieConsent.astro'
import Scripts from '../components/Scripts.astro';
import ThemeInit from '../components/ThemeInit.astro';
---

<!doctype html>
<html lang="en">
  <head>
    <ThemeInit />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Page not found - Mateus Villain</title>

    <meta name="robots" content="noindex, nofollow" />
    <meta name="author" content="Mateus Villain" />
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <link rel="icon" type="image/x-icon" href="/img/favicon.png" />

    
    <ConsentScript />

    <style is:inline>
      @import 'https://fonts.googleapis.com/css?family=VT323';

      body,
      h1,
      h2,
      h3,
      h4,
      h5,
      h6,
      p,
      a {
        color: #e0e2f4;
        margin: 0;
        padding: 0;
      }

      body,
      p {
        font:
          normal 20px/1.25rem 'VT323',
          monospace;
      }
      h1 {
        font:
          normal 2.75rem/1.05em 'VT323',
          monospace;
      }
      h2 {
        font:
          normal 2.25rem/1.25em 'VT323',
          monospace;
      }
      h3 {
        font:
          lighter 1.5rem/1.25em 'VT323',
          monospace;
      }
      h4 {
        font:
          lighter 1.125rem/1.2222222em 'VT323',
          monospace;
      }

      body {
        background: #0414a7;
      }

      .container {
        display: flex;
        justify-content: center;
        align-items: center;
        height: 100vh;
      }

      .content {
        text-align: left;
      }

      h1 {
        display: inline-block;
        color: #0414a7;
        background: #aaaaaa;
        padding: 0 16px 2px 12px;
        margin-bottom: 24px;
      }

      a {
        margin-left: -8px;
        text-decoration: none;
        padding: 0 9px 2px 8px;
      }
      a:hover,
      a:focus {
        background: #aaaaaa;
        color: #0414a7;
      }

      .skip-link {
        position: absolute;
        top: 8px;
        left: 8px;
        padding: 8px 12px;
        z-index: 1000;
        background: #aaaaaa;
        color: #0414a7;
        transform: translateY(-150%);
      }

      .skip-link:focus,
      .skip-link:focus-visible {
        transform: translateY(0);
      }

      nav {
        display: flex;
      }
      nav > p + p::before {
        content: '|';
        margin: 0 8px;
      }

      ul {
        list-style: none;
        padding-left: 0;
      }
      ul li::before {
        content: '* ';
      }
    </style>
  </head>
  <body>
    <slot />
    <Scripts />
    <CookieConsent locale="en" />
  </body>
</html>
