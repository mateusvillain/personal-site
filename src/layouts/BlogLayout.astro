---
/**
 * Layout da listagem e dos posts do blog. `showAuthor` liga o bloco do
 * autor e o botao de copiar codigo (so fazem sentido dentro de um post).
 * `switchPath` e o caminho desta pagina no outro idioma, usado pela troca de
 * idioma do cabecalho.
 */
import '@lets-ui/styles'
import SeoHead from '../components/SeoHead.astro'
import CookieConsent from '../components/CookieConsent.astro'
import Scripts from '../components/Scripts.astro'
import ThemeInit from '../components/ThemeInit.astro'
import SiteHeader from '../components/SiteHeader.astro'
import NewsletterCard from '../components/NewsletterCard.astro'
import AuthorCard from '../components/AuthorCard.astro'
import { htmlLang, type Locale } from '../i18n/config'
import { ui } from '../i18n/ui'

interface Props {
  locale: Locale
  switchPath: string
  title: string
  description: string
  canonicalPath: string
  alternates?: Partial<Record<Locale, string>>
  cover?: string
  publishedTime?: string
  tags?: string[]
  jsonLd?: object | object[]
  markdownPath?: string
  showAuthor?: boolean
}

const {
  locale,
  switchPath,
  title,
  description,
  canonicalPath,
  alternates,
  cover,
  publishedTime,
  tags,
  jsonLd,
  markdownPath,
  showAuthor = false,
} = Astro.props

const strings = ui[locale]
const defaultCover = showAuthor ? '/blog/covers/cover.png' : '/img/cover.png'

/**
 * Liga o marca-texto animado antes da primeira pintura, para o destaque nao
 * aparecer pronto e so entao encolher para animar. Se o script do marca-texto
 * nao assumir o controle a tempo - deploy pela metade, asset bloqueado -, a
 * flag cai sozinha: destaque escondido seria pior que destaque sem animacao.
 */
const highlightBoot = `
if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
  document.documentElement.dataset.hlAnimate = ''
  window.__hlFallback = setTimeout(function () {
    document.documentElement.removeAttribute('data-hl-animate')
  }, 3000)
}
`
---

<!doctype html>
<html lang={htmlLang[locale]} data-brand="mateus-villain">
  <head>
    <ThemeInit />
    <SeoHead
      locale={locale}
      title={title}
      description={description}
      canonicalPath={canonicalPath}
      alternates={alternates}
      image={cover ?? defaultCover}
      publishedTime={publishedTime}
      tags={tags}
      jsonLd={jsonLd}
      markdownPath={markdownPath}
    />

    <link rel="stylesheet" href="/style.css" />
    <link rel="stylesheet" href="/blog.css" />

    {showAuthor && <script is:inline set:html={highlightBoot} />}
  </head>

  <body>
    <a href="#main" class="skip-link">{strings.skipLink}</a>
    <SiteHeader locale={locale} switchPath={switchPath} />
    <div class="body-container gap-fluid-80 m-b-fluid-80">
      <main id="main">
        <section class="post-list">
          <slot />
        </section>
      </main>

      {showAuthor && <AuthorCard locale={locale} />}

      <NewsletterCard locale={locale} />
    </div>

    {showAuthor && <script is:inline src="/blog/js/code-copy.js" defer></script>}
    {showAuthor && <script is:inline src="/blog/js/highlight.js" defer></script>}
    <script is:inline src="/blog/js/form.js" defer></script>
    <Scripts />
    <CookieConsent locale={locale} />
  </body>
</html>
